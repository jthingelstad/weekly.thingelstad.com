# weekly.thingelstad.com — landing-page stats only.
#
# This is a render surface. Publishing secrets live in WT Builder
# (`wt-builder`); archive, corpus, and Lambda secrets live in
# `librarian-thing`. The only credentials this repo reads are the two its own
# CI uses for the landing-page numbers (scripts/refresh-stats.mjs).
#
# See README.md and AGENTS.md for the producer/render split.

# Buttondown — subscriber count for the landing page.
BUTTONDOWN_API_KEY=

# Stripe — supporter count + totals for the landing page.
STRIPE_API_KEY=
