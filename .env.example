# weekly.thingelstad.com — landing-page stats only.
#
# This is a render surface. Production secrets (Buttondown publish, OpenAI,
# AWS, Librarian, Discord/workshop_bot) live in `studio-thing`. The only
# credentials this repo needs are the ones its own CI fetches for the
# landing-page numbers (subscriber + supporter stats).
#
# See README.md and CLAUDE.md for the producer/render split.

# Buttondown — subscriber count for the landing page.
BUTTONDOWN_API_KEY=your-buttondown-api-key

# Stripe — supporter count + totals for the landing page.
STRIPE_API_KEY=your-stripe-secret-key

# Tinylytics — privacy-focused analytics embed.
TINYLYTICS_API_KEY=your-tinylytics-full-access-api-key
TINYLYTICS_SITE_ID=3063
TINYLYTICS_SITE_UID=a2YQr3ZMqkySNYSwz4uF
