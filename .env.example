BUTTONDOWN_API_KEY=your-buttondown-api-key
STRIPE_API_KEY=your-stripe-secret-key
OPENAI_API_KEY=your-openai-api-key
TINYLYTICS_API_KEY=your-tinylytics-full-access-api-key
TINYLYTICS_SITE_ID=3063
TINYLYTICS_SITE_UID=a2YQr3ZMqkySNYSwz4uF

# MailChimp — used for archive recovery/audit tooling (pipeline/one-shot/fetch_mailchimp.py)
MAILCHIMP_API_KEY=your-mailchimp-api-key-usN

# Anthropic — description generation (pipeline/content/generate_descriptions.py)
ANTHROPIC_API_KEY=your-anthropic-api-key

# AWS — scoped IAM user for public archive assets and private Thingy artifacts
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
AWS_DEFAULT_REGION=us-east-1
WEEKLY_THING_ASSETS_BUCKET=files.thingelstad.com
LIBRARIAN_BUCKET=weekly-thing-librarian
LIBRARIAN_CORPUS_KEY=artifacts/corpus.json
LIBRARIAN_GRAPH_KEY=artifacts/graph.json
BEDROCK_EVAL_ROLE_ARN=arn:aws:iam::123456789012:role/weekly-thing-bedrock-eval
BEDROCK_INVOCATION_LOG_PREFIX=logs/invocations

# Workshop Bot — four-persona Discord bot at apps/workshop_bot/
# Each persona is a separate Discord application with its own bot token.
DISCORD_TOKEN_EDDY=
DISCORD_TOKEN_LINKY=
DISCORD_TOKEN_MARKY=
DISCORD_TOKEN_PATTY=
# Thingy is a separate Discord application (public-facing bridge). Leave
# the token blank until the Discord app exists; the bot will skip it.
DISCORD_TOKEN_THINGY=
DISCORD_SERVER_ID=
DISCORD_WORKSHOP_CATEGORY_ID=
DISCORD_TEAM_ROLE_ID=
DISCORD_CHANNEL_EDITORIAL=
DISCORD_CHANNEL_RESEARCH=
DISCORD_CHANNEL_PROMOTION=
DISCORD_CHANNEL_SUPPORTERS=
DISCORD_CHANNEL_WORKSHOP=
DISCORD_CHANNEL_CHATTER=
DISCORD_CHANNEL_ASK_THINGY=

# Jamie's Discord user ID — agents render `<@DISCORD_OWNER_USER_ID>` when
# they need to @-mention him directly (e.g., from a scheduled job).
DISCORD_OWNER_USER_ID=

# Thingy bridge — points at the deployed Librarian Lambda. Defaults
# match the production URLs in apps/site/_data/site.js. The bridge
# secret must also be set in the Lambda's DISCORD_BRIDGE_SECRET env var
# (see apps/librarian/infra/cloudformation.yaml).
LIBRARIAN_API_URL=
LIBRARIAN_STREAM_URL=
LIBRARIAN_BRIDGE_SECRET=
WEEKLY_THING_SITE_URL=https://weekly.thingelstad.com

# Pinboard — used by Linky and the update-draft Notable/Briefly fills
PINBOARD_API_TOKEN=

# micro.blog — Jamie's personal site is micro.blog-hosted; update-draft's
# Journal fill reads his public JSON Feed. MICROBLOG_FEED_URL defaults to
# https://www.thingelstad.com/feed.json; set it if the hostname differs.
# MICROBLOG_API_KEY is reserved for future authenticated micro.blog work.
MICROBLOG_FEED_URL=https://www.thingelstad.com/feed.json
MICROBLOG_API_KEY=

# Workshop bot runtime config
WORKSHOP_DB_PATH=apps/workshop_bot/data/workshop.db
WORKSHOP_LOG_LEVEL=INFO

# Heartbeats (per-persona scheduled wake-up turns).
# Set to 0 to silence all heartbeats.
WORKSHOP_HEARTBEATS_ENABLED=1
WORKSHOP_HEARTBEAT_MODEL=haiku
# Model for Eddy's post-update review (default: haiku Tue/Wed, sonnet Thu/Fri).
# WORKSHOP_EDDY_REVIEW_MODEL=sonnet
# RSS feed Marky polls for newly-published issues (default shown).
WEEKLY_THING_FEED_URL=https://weekly.thingelstad.com/feed.xml
