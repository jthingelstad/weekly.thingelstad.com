{
  "name": "weekly-thing-site",
  "version": "1.0.0",
  "description": "The Weekly Thing — newsletter landing page and archive",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "eleventy --config apps/site/eleventy.config.js",
    "build:search": "pagefind --site _site --glob '**/*.html'",
    "build:all": "npm run build && npm run build:search",
    "serve": "eleventy --serve --config apps/site/eleventy.config.js",
    "refresh-stats": "node scripts/refresh-stats.mjs",
    "sites:sync": "node scripts/sync-sites.mjs",
    "sites:check": "node scripts/sync-sites.mjs --check",
    "test": "npm run sites:check && npm run test:unit && npm run build:all && npm run test:e2e",
    "test:docs": "node scripts/check-doc-symlinks.mjs",
    "test:unit": "TZ=UTC node --test 'tests/unit/*.test.mjs'",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "infra:generate": "node infra/templates.mjs",
    "infra": "node scripts/infra.mjs",
    "deploy:aws": "node scripts/deploy-aws.mjs"
  },
  "dependencies": {
    "@11ty/eleventy": "^3.0.0",
    "markdown-it-anchor": "^9.2.1",
    "pagefind": "^1.3.0"
  },
  "devDependencies": {
    "@aws-sdk/client-acm": "^3.1157.0",
    "@aws-sdk/client-cloudformation": "^3.1157.0",
    "@aws-sdk/client-cloudfront": "^3.1157.0",
    "@aws-sdk/client-s3": "^3.1157.0",
    "@aws-sdk/client-sts": "^3.1157.0",
    "@playwright/test": "^1.61.1"
  },
  "overrides": {
    "@11ty/recursive-copy": "5.0.2",
    "brace-expansion": "5.0.12"
  }
}
