{
  "name": "weekly-thing-site",
  "version": "1.0.0",
  "description": "The Weekly Thing — newsletter landing page and archive",
  "scripts": {
    "build": "eleventy",
    "build:search": "pagefind --site _site --glob '**/*.html'",
    "build:all": "npm run build && npm run build:search",
    "serve": "eleventy --serve",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "data": "python pipeline/content/content.py build && python pipeline/librarian/build_librarian_corpus.py",
    "librarian:corpus": "python pipeline/librarian/build_librarian_corpus.py",
    "librarian:corpus:upload": "python pipeline/librarian/upload_librarian_corpus.py",
    "librarian:graph": "python pipeline/librarian/build_librarian_graph.py",
    "librarian:graph:upload": "python pipeline/librarian/build_librarian_graph.py --upload",
    "librarian:eval": "python pipeline/librarian/eval_librarian_rag.py",
    "librarian:eval:answers": "python pipeline/librarian/eval_librarian_answers.py",
    "librarian:conversations": "python pipeline/librarian/review_librarian_conversations.py",
    "librarian:deploy": "python pipeline/librarian/deploy_librarian_aws.py",
    "librarian:test": "npm --prefix services/librarian test",
    "data:fresh": "python pipeline/content/content.py pull --all",
    "content:pull": "python pipeline/content/content.py pull --all",
    "content:pull:latest": "python pipeline/content/content.py pull --latest",
    "content:pull:latest:skip-existing": "python pipeline/content/content.py pull --latest --skip-existing",
    "content:build": "python pipeline/content/content.py build",
    "content:diff": "python pipeline/content/content.py diff",
    "content:push": "python pipeline/content/content.py push --dry-run",
    "content:push:live": "python pipeline/content/content.py push --yes",
    "fetch:latest": "python pipeline/content/content.py pull --latest",
    "fetch:latest:skip-existing": "python pipeline/content/content.py pull --latest --skip-existing",
    "sync": "python pipeline/content/content.py push --dry-run",
    "sync:push": "python pipeline/content/content.py push --yes",
    "refresh-copy": "python pipeline/content/refresh_marketing_copy.py",
    "refresh-copy:dry": "python pipeline/content/refresh_marketing_copy.py --dry-run"
  },
  "dependencies": {
    "@11ty/eleventy": "^3.0.0",
    "markdown-it-anchor": "^9.2.0",
    "pagefind": "^1.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1"
  }
}
