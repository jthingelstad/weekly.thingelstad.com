---
layout: layouts/base.njk
pageTitle: Pipeline Ops
description: Per-issue pipeline state. Not linked from anywhere; reachable by direct URL.
permalink: /ops/
eleventyExcludeFromCollections: true
---
<noscript></noscript>
<meta name="robots" content="noindex,nofollow">

<section class="ops-page">
  <div class="container-narrow">
    <p class="eyebrow">Pipeline Ops</p>
    <h1 class="ops-title">Per-issue state at every stage</h1>
    {% if status %}
    <p class="ops-meta">
      Generated <time datetime="{{ status.generated_at }}">{{ status.generated_at }}</time>.
      {% if status.summary.deployed_corpus_uploaded_at %}
      Deployed corpus uploaded <time datetime="{{ status.summary.deployed_corpus_uploaded_at }}">{{ status.summary.deployed_corpus_uploaded_at }}</time>;
      latest archive change <time datetime="{{ status.summary.latest_archive_modified_at }}">{{ status.summary.latest_archive_modified_at }}</time>.
      {% endif %}
    </p>

    <div class="ops-summary">
      <div class="ops-stat"><strong>{{ status.summary.total_issues }}</strong><span>issues</span></div>
      <div class="ops-stat"><strong>{{ status.summary.audio_rendered }}</strong><span>audio rendered</span></div>
      <div class="ops-stat ops-stat-{% if status.summary.audio_out_of_date > 0 %}warn{% else %}ok{% endif %}"><strong>{{ status.summary.audio_out_of_date }}</strong><span>audio stale</span></div>
      <div class="ops-stat"><strong>{{ status.summary.audio_missing }}</strong><span>audio missing</span></div>
      <div class="ops-stat ops-stat-{% if status.summary.buttondown_local_edits > 0 %}warn{% else %}ok{% endif %}"><strong>{{ status.summary.buttondown_local_edits }}</strong><span>uncommitted body edits</span></div>
      <div class="ops-stat ops-stat-{% if status.summary.librarian_likely_stale %}warn{% else %}ok{% endif %}"><strong>{% if status.summary.librarian_likely_stale %}stale{% else %}ok{% endif %}</strong><span>thingy corpus</span></div>
    </div>

    <table class="ops-table">
      <thead>
        <tr>
          <th>#</th>
          <th>Date</th>
          <th>Subject</th>
          <th>Body</th>
          <th>Archive</th>
          <th>Audio</th>
          <th>Audio status</th>
          <th>Last rendered</th>
        </tr>
      </thead>
      <tbody>
      {% for row in status.issues | reverse %}
        <tr>
          <td><a href="/archive/{{ row.number }}/">#{{ row.number }}</a></td>
          <td><time datetime="{{ row.publish_date }}">{{ row.publish_date | dateShort }}</time></td>
          <td>{{ row.subject }}</td>
          <td>{% if row.body.has_local_edits %}<span class="ops-flag warn">edits</span>{% elif row.body.tracked %}<span class="ops-flag ok">ok</span>{% else %}<span class="ops-flag muted">—</span>{% endif %}</td>
          <td>{% if row.archive.exists %}{{ row.archive.word_count or "—" }}w{% else %}<span class="ops-flag warn">missing</span>{% endif %}</td>
          <td>{% if row.audio.in_manifest %}<span class="ops-flag ok">{{ row.audio.duration_seconds }}s</span>{% else %}<span class="ops-flag muted">—</span>{% endif %}</td>
          <td>{% if row.audio.out_of_date %}<span class="ops-flag warn">STALE</span>{% elif row.audio.in_manifest %}<span class="ops-flag ok">ok</span>{% else %}<span class="ops-flag muted">—</span>{% endif %}</td>
          <td>{% if row.audio.rendered_at %}<time datetime="{{ row.audio.rendered_at }}">{{ row.audio.rendered_at | dateShort }}</time>{% endif %}</td>
        </tr>
      {% endfor %}
      </tbody>
    </table>

    <p class="ops-note">JSON: <a href="/status.json">/status.json</a>. This page is not linked from elsewhere on the site and is excluded from sitemap and search index.</p>
    {% else %}
    <p class="ops-note">Status JSON has not been generated yet. Run <code>python pipeline/status.py --json site/_data/status.json</code> locally, or push to trigger CI.</p>
    {% endif %}
  </div>
</section>
