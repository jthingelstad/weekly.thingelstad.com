---
layout: layouts/base.njk
pageTitle: Search
description: Search the full archive of the Weekly Thing newsletter.
permalink: /search/
---
<section class="search-hero">
  <div class="container-narrow">
    <p class="eyebrow">Search the archive</p>
    <h1 class="search-title">Find <em>anything</em> from {{ archiveStats.yearsActive }} years of letters.</h1>
    <p class="search-lede">Full-text search across every issue I've ever sent. Every link, every note, every rabbit hole.</p>
    <div id="search" class="search-pf-wrap"></div>
    <div class="search-meta">
      <span><strong>{{ collections.issuesByDate[0].data.number }}</strong> issues</span>
      <span>&middot;</span>
      <span><strong>{{ archiveStats.totalLinks | numberFormat }}</strong> links</span>
      <span>&middot;</span>
      <span><strong>{{ archiveStats.uniqueDomainsTotal | numberFormat }}</strong> domains indexed</span>
    </div>
  </div>
</section>

<section class="search-suggest" id="search-suggestions">
  <div class="container-narrow">
    <div class="search-block">
      <p class="eyebrow">Example searches</p>
      <div class="search-tags">
        <button class="search-tag search-tag-example" data-query="agentic engineering">&#9906; agentic engineering</button>
        <button class="search-tag search-tag-example" data-query="&quot;link rot&quot;">&#9906; "link rot"</button>
        <button class="search-tag search-tag-example" data-query="IndieWeb">&#9906; IndieWeb</button>
        <button class="search-tag search-tag-example" data-query="POAP">&#9906; POAP</button>
        <button class="search-tag search-tag-example" data-query="cheeseburger">&#9906; cheeseburger</button>
      </div>
    </div>

    <div class="search-block">
      <p class="eyebrow">Popular topics</p>
      <div class="search-tags">
        <button class="search-tag" data-query="AI">AI</button>
        <button class="search-tag" data-query="Apple">Apple</button>
        <button class="search-tag" data-query="open web">open web</button>
        <button class="search-tag" data-query="privacy">privacy</button>
        <button class="search-tag" data-query="design">design</button>
        <button class="search-tag" data-query="productivity">productivity</button>
        <button class="search-tag" data-query="journalism">journalism</button>
        <button class="search-tag" data-query="data visualization">data viz</button>
        <button class="search-tag" data-query="software engineering">software engineering</button>
      </div>
    </div>

    <div class="search-tip-grid">
      <div class="search-tip">
        <p class="eyebrow">Tip &middot; Phrases</p>
        <p>Use quotes for exact matches: <code>"link rot"</code></p>
      </div>
      <div class="search-tip">
        <p class="eyebrow">Tip &middot; Filter</p>
        <p>Narrow by year using the sidebar after searching.</p>
      </div>
      <div class="search-tip">
        <p class="eyebrow">Tip &middot; Bookmark</p>
        <p>Searches sync to the URL &mdash; share or save them.</p>
      </div>
      <div class="search-tip search-tip-cta">
        <p class="eyebrow">Or just ask</p>
        <p>Subscribers can ask <a href="/thingy/">Thingy</a>, the archive librarian, in plain English &rarr;</p>
      </div>
    </div>
  </div>
</section>

<link href="/pagefind/pagefind-ui.css" rel="stylesheet">
<script src="/pagefind/pagefind-ui.js"></script>
<script>
  window.addEventListener('DOMContentLoaded', () => {
    const pf = new PagefindUI({
      element: "#search",
      showSubResults: true,
      showImages: false,
    });

    const suggestions = document.getElementById('search-suggestions');

    function hideSuggestions() { if (suggestions) suggestions.style.display = 'none'; }
    function showSuggestions() { if (suggestions) suggestions.style.display = ''; }

    // Auto-open year filter and reverse sort (newest first)
    new MutationObserver((_, obs) => {
      const yearGroup = document.querySelector('.pagefind-ui__filter-group');
      if (!yearGroup) return;
      const details = yearGroup.closest('details') || yearGroup.querySelector('details');
      if (details) details.open = true;
      const panel = yearGroup.querySelector('.pagefind-ui__filter-panel');
      if (!panel || panel.dataset.reversed) return;
      const items = Array.from(panel.children);
      if (items.length > 1) {
        items.reverse().forEach(el => panel.appendChild(el));
        panel.dataset.reversed = 'true';
      }
    }).observe(document.getElementById('search'), { childList: true, subtree: true });

    // Suggestion tag clicks
    document.querySelectorAll('.search-tag').forEach(btn => {
      btn.addEventListener('click', () => {
        const q = btn.dataset.query;
        pf.triggerSearch(q);
        const input = document.querySelector('#search input[type="text"]');
        if (input) input.value = q;
        const url = new URL(window.location);
        url.searchParams.set('q', q);
        history.replaceState(null, '', url);
        hideSuggestions();
      });
    });

    // Sync search query with URL
    const params = new URLSearchParams(window.location.search);
    const q = params.get('q');
    if (q) {
      pf.triggerSearch(q);
      hideSuggestions();
    }

    // Update URL on search and toggle suggestions
    const input = document.querySelector('#search input[type="text"]');
    if (input) {
      input.addEventListener('input', () => {
        const val = input.value;
        const url = new URL(window.location);
        if (val) {
          url.searchParams.set('q', val);
          hideSuggestions();
        } else {
          url.searchParams.delete('q');
          showSuggestions();
        }
        history.replaceState(null, '', url);
      });
    }
  });
</script>
