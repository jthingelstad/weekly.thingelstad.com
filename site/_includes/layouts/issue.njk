---
layout: layouts/base.njk
ogType: article
---
{%- set pageTitle = subject -%}
{%- set allIssues = collections.issuesByNumber -%}
{%- set currentIndex = -1 -%}
{%- for item in allIssues -%}
  {%- if item.data.number == number -%}
    {%- set currentIndex = loop.index0 -%}
  {%- endif -%}
{%- endfor -%}
{%- set prev2 = allIssues[currentIndex - 2] if currentIndex > 1 else null -%}
{%- set prev1 = allIssues[currentIndex - 1] if currentIndex > 0 else null -%}
{%- set next1 = allIssues[currentIndex + 1] if currentIndex >= 0 and currentIndex < allIssues.length - 1 else null -%}
{%- set next2 = allIssues[currentIndex + 2] if currentIndex >= 0 and currentIndex < allIssues.length - 2 else null -%}
{%- set toc = content | extractToc -%}
{%- set readMinutes = (word_count / 200) | round if word_count else 0 -%}

{% block head %}
  <link rel="alternate" type="application/atom+xml" title="Links from Issue #{{ number }}" href="/archive/{{ number }}/links.xml">
{% endblock %}

<article class="issue" data-pagefind-body>
  {# Top issue chrome — Archive crumb + arrow pager #}
  <div class="issue-bar">
    <div class="container-wide">
      <div class="issue-bar-inner">
        <a href="/archive/" class="issue-back">&larr; Archive</a>
        <div class="issue-pager">
          {% if prev1 %}<a href="/archive/{{ prev1.data.number }}/" class="issue-pager-btn" title="Issue {{ prev1.data.number }}: {{ prev1.data.subject }}">&lsaquo; #{{ prev1.data.number }}</a>{% endif %}
          {% if next1 %}<a href="/archive/{{ next1.data.number }}/" class="issue-pager-btn" title="Issue {{ next1.data.number }}: {{ next1.data.subject }}">#{{ next1.data.number }} &rsaquo;</a>{% endif %}
        </div>
      </div>
    </div>
  </div>

  <header class="issue-hero">
    <div class="container-narrow">
      <p class="eyebrow">Weekly Thing #<span data-pagefind-meta="issue">{{ number }}</span> &middot; <time datetime="{{ publish_date | dateFormat('iso') }}" data-pagefind-meta="date">{{ publish_date | dateFormat }}</time></p>
      <span data-pagefind-filter="year" hidden>{{ publish_date | year }}</span>
      <h1 class="issue-title" data-pagefind-meta="title">{{ subject }}</h1>
      {% if description %}
      <p class="issue-dek">{{ description }}</p>
      {% endif %}
      <div class="issue-byline">
        <img src="/img/jamie-thingelstad.jpg" alt="" class="issue-byline-avatar" loading="lazy" width="44" height="44">
        <div>
          <div class="issue-byline-name">Jamie Thingelstad</div>
          <div class="issue-byline-meta">
            {% if word_count %}{{ word_count | numberFormat }} words{% if readMinutes > 0 %} &middot; ~{{ readMinutes }} min read{% endif %}{% endif %}
          </div>
        </div>
        <div class="issue-byline-actions">
          <button class="tinylytics_kudos issue-action" data-path="/archive/{{ number }}/">
            <span aria-hidden="true">&#9825;</span>
            <span class="kudos-label">Kudos</span>
            <span class="kudos-count tinylytics_kudos_count"></span>
          </button>
          <button class="share-button issue-action" data-url="{{ site.url }}/archive/{{ number }}/" data-title="{{ subject }}" data-tinylytics-event="issue.share" data-tinylytics-event-value="{{ number }}">
            <span aria-hidden="true">&#8599;</span>
            <span class="share-label">Share</span>
          </button>
          {% if audio_url %}
          <a href="#listen" class="issue-action issue-action-primary">Listen &#9656;</a>
          {% endif %}
        </div>
      </div>
    </div>
  </header>

  {% if image %}
  <figure class="issue-cover">
    <img class="issue-cover-img" src="{{ image }}" alt="" loading="lazy">
    {% if description %}<figcaption class="issue-cover-cap">{{ description }}</figcaption>{% endif %}
  </figure>
  {% endif %}

  {% if audio_url %}
  <div class="issue-audio container-narrow" id="listen">
    <div class="issue-audio-label">Listen</div>
    <audio controls preload="none" src="{{ audio_url }}">
      <a href="{{ audio_url }}">Download the MP3</a>
    </audio>
  </div>
  {% endif %}

  <div class="issue-layout container-wide">
    <aside class="issue-toc">
      {% if toc.length > 0 %}
      <p class="eyebrow">In this issue</p>
      <ol class="issue-toc-list">
        {% for heading in toc %}
        <li class="issue-toc-item issue-toc-level-{{ heading.level }}">
          <a href="#{{ heading.id }}">{{ heading.text }}</a>
        </li>
        {% endfor %}
      </ol>
      {% endif %}

      {% if domains.length > 0 %}
      <div class="issue-toc-aside">
        <p class="eyebrow">Linked domains</p>
        <ul class="issue-domain-list">
          {% for domain in domains | slice(0, 12) %}
          <li>{{ domain }}</li>
          {% endfor %}
          {% if domains.length > 12 %}<li class="issue-domain-more">+ {{ domains.length - 12 }} more</li>{% endif %}
        </ul>
      </div>
      {% endif %}

      <div class="issue-toc-aside">
        <p class="eyebrow">Discuss</p>
        <a href="https://www.reddit.com/r/weeklything/" class="issue-toc-discuss">r/WeeklyThing &rarr;</a>
      </div>
    </aside>

    <div class="issue-content">
      {{ content | safe }}
    </div>
  </div>

  <nav class="issue-prevnext" aria-label="Issue navigation">
    <div class="container-wide">
      <p class="eyebrow issue-prevnext-label">Continue reading</p>
      <div class="issue-prevnext-grid">
        {% if prev2 %}
        <a href="/archive/{{ prev2.data.number }}/" class="issue-prevnext-card issue-prev">
          <span class="issue-prevnext-arrow">&larr;</span>
          <div class="issue-prevnext-body">
            <span class="issue-prevnext-num">#{{ prev2.data.number }}</span>
            <span class="issue-prevnext-title">{{ prev2.data.subject }}</span>
          </div>
        </a>
        {% endif %}
        {% if prev1 %}
        <a href="/archive/{{ prev1.data.number }}/" class="issue-prevnext-card issue-prev">
          <span class="issue-prevnext-arrow">&larr;</span>
          <div class="issue-prevnext-body">
            <span class="issue-prevnext-num">#{{ prev1.data.number }}</span>
            <span class="issue-prevnext-title">{{ prev1.data.subject }}</span>
          </div>
        </a>
        {% endif %}
        {% if next1 %}
        <a href="/archive/{{ next1.data.number }}/" class="issue-prevnext-card issue-next">
          <div class="issue-prevnext-body">
            <span class="issue-prevnext-num">#{{ next1.data.number }}</span>
            <span class="issue-prevnext-title">{{ next1.data.subject }}</span>
          </div>
          <span class="issue-prevnext-arrow">&rarr;</span>
        </a>
        {% endif %}
        {% if next2 %}
        <a href="/archive/{{ next2.data.number }}/" class="issue-prevnext-card issue-next">
          <div class="issue-prevnext-body">
            <span class="issue-prevnext-num">#{{ next2.data.number }}</span>
            <span class="issue-prevnext-title">{{ next2.data.subject }}</span>
          </div>
          <span class="issue-prevnext-arrow">&rarr;</span>
        </a>
        {% endif %}
      </div>
    </div>
  </nav>

  <section class="issue-cta-foot">
    <div class="container-narrow">
      <p class="eyebrow">Subscribe</p>
      {% set subscribeId = "issue" %}
      {% include "partials/subscribe-form.njk" %}
    </div>
  </section>
</article>
<script>
(function() {
  var shareButton = document.querySelector('.share-button');
  if (shareButton) {
    shareButton.addEventListener('click', function() {
      var btn = this;
      var url = btn.dataset.url;
      var title = btn.dataset.title;
      var label = btn.querySelector('.share-label');
      var originalLabel = label ? label.textContent : btn.textContent;
      if (navigator.share) {
        navigator.share({ title: title, url: url });
      } else if (navigator.clipboard) {
        navigator.clipboard.writeText(url).then(function() {
          if (label) {
            label.textContent = 'Copied';
            setTimeout(function() { label.textContent = originalLabel; }, 2000);
          }
        });
      }
    });
  }
})();
</script>
