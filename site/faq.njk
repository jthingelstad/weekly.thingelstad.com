---
layout: layouts/page.njk
pageTitle: FAQ
description: Frequently asked questions about the Weekly Thing newsletter.
permalink: /faq/
---
{% set faqValues = {
  yearsActive: archiveStats.yearsActive,
  issueCount: collections.issuesByDate[0].data.number
} %}
<div class="faq-page">
  {% for section in faq.sections %}
    <section class="faq-section">
      <h2>{{ section.title }}</h2>
      <dl class="faq-list">
        {% for item in section.entries %}
          <div class="faq-item">
            <dt>{{ item.question }}</dt>
            <dd>{{ item.answer | faqAnswer(faqValues) | markdownify | safe }}</dd>
          </div>
        {% endfor %}
      </dl>
    </section>
  {% endfor %}
  <section class="faq-section">
    <h2>Audio</h2>
    <dl class="faq-list">
      <div class="faq-item">
        <dt>Is there an audio version?</dt>
        <dd><p>Selected issues include a Listen control on the issue page and in the archive. Podcast apps can subscribe at <a href="/podcast.xml">/podcast.xml</a>.</p></dd>
      </div>
    </dl>
  </section>
</div>
