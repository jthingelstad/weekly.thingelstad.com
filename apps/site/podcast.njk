---
permalink: /podcast.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<rss version="2.0"
     xmlns:itunes="http://www.itunes.com/dtds/podcast-1.0.dtd"
     xmlns:content="http://purl.org/rss/1.0/modules/content/"
     xmlns:atom="http://www.w3.org/2005/Atom"
     xmlns:podcast="https://podcastindex.org/namespace/1.0">
  <channel>
    <title>{{- site.title | xmlEscape -}}</title>
    <description>{{- site.description | xmlEscape -}}</description>
    <link>{{- site.url -}}/</link>
    <atom:link href="{{ site.url }}/podcast.xml" rel="self" type="application/rss+xml"/>
    <language>en-us</language>
    <copyright>© {{ "" | currentYear }} Jamie Thingelstad</copyright>
    {%- if collections.podcastEpisodes and collections.podcastEpisodes.length > 0 %}
    <lastBuildDate>{{- collections.podcastEpisodes[0].data.publish_date | dateFormat('rfc822') -}}</lastBuildDate>
    {%- endif %}
    <generator>Eleventy</generator>
    <itunes:author>{{- site.author | xmlEscape -}}</itunes:author>
    <itunes:summary>A weekly collection of interesting links, ideas, and observations from across the internet, curated by Jamie Thingelstad.</itunes:summary>
    <itunes:type>episodic</itunes:type>
    <itunes:owner>
      <itunes:name>Jamie Thingelstad</itunes:name>
      <itunes:email>jamie@thingelstad.com</itunes:email>
    </itunes:owner>
    <itunes:explicit>false</itunes:explicit>
    <itunes:category text="Technology"/>
    <itunes:category text="News">
      <itunes:category text="Tech News"/>
    </itunes:category>
    <itunes:image href="{{ site.url }}/img/podcast-cover.png"/>
    <!-- Permanent podcast GUID — must NEVER be regenerated. -->
    <podcast:guid>7E18C1A2-0A50-459E-A683-D8050F31470B</podcast:guid>
    <podcast:locked owner="jamie@thingelstad.com">no</podcast:locked>
    {%- for issue in collections.podcastEpisodes %}
    <item>
      {% set subjectParts = issue.data.subject | split(" / ") -%}
      {%- set subjectTail = subjectParts | last if subjectParts.length > 1 else issue.data.subject -%}
      {%- if issue.data.subject.startsWith("WT") -%}
      {%- set episodeTitle = issue.data.subject -%}
      {%- else -%}
      {%- set episodeTitle = "#" + (issue.data.number | string) + " — " + subjectTail -%}
      {%- endif -%}
      {%- set issueUrl = site.url + '/archive/' + (issue.data.number | string) + '/' -%}
      <title>{{- episodeTitle | xmlEscape -}}</title>
      <link>{{- issueUrl -}}</link>
      <guid isPermaLink="false">weekly-thing-{{ issue.data.number }}-audio</guid>
      <pubDate>{{- issue.data.publish_date | dateFormat('rfc822') -}}</pubDate>
      <description>{{- (issue.data.description or "") | xmlEscape -}}</description>
      <itunes:summary>{{- (issue.data.description or "") | xmlEscape -}}</itunes:summary>
      {#- Show notes: the description, then every chapter with the minute it is
          spoken at and its link. WT Builder stamps `audio_chapters` since WT350
          (2026-09-21); older episodes have only the description. Every app
          renders these, chapter support or not. -#}
      <content:encoded><![CDATA[{%- if issue.data.description %}<p>{{ issue.data.description | xmlEscape }}</p>{% endif %}<p><a href="{{ issueUrl }}">Read this issue on the web →</a></p>
      {%- if issue.data.audio_chapters and issue.data.audio_chapters.length %}<p><strong>In this episode</strong></p><ul>
        {%- for chapter in issue.data.audio_chapters %}<li>{{ chapter.start | clock }} — {% if chapter.url and chapter.url != issueUrl %}<a href="{{ chapter.url | xmlEscape }}">{{ chapter.title | xmlEscape }}</a>{% else %}{{ chapter.title | xmlEscape }}{% endif %}</li>{% endfor %}
      </ul>{% endif -%}]]></content:encoded>
      <itunes:author>Jamie Thingelstad</itunes:author>
      <itunes:explicit>false</itunes:explicit>
      <itunes:episode>{{- issue.data.number -}}</itunes:episode>
      <itunes:episodeType>full</itunes:episodeType>
      <itunes:image href="{{ site.url }}/img/podcast-cover.png"/>
      <itunes:duration>{{- issue.data.audio_duration_seconds | itunesDuration -}}</itunes:duration>
      <enclosure url="{{ issue.data.audio_url }}" length="{{ issue.data.audio_byte_size or 0 }}" type="audio/mpeg"/>
      {#- Podcasting 2.0: the chapter list (every link with its URL, photos as
          art) and the transcript live beside the mp3 on the CDN. Apple Podcasts
          and Pocket Casts read these; Overcast reads the same chapters from
          inside the mp3. -#}
      {%- if issue.data.audio_chapters_url %}
      <podcast:chapters url="{{ issue.data.audio_chapters_url }}" type="application/json+chapters"/>
      {%- endif %}
      {%- if issue.data.audio_transcript_url %}
      <podcast:transcript url="{{ issue.data.audio_transcript_url }}" type="text/vtt"/>
      {%- endif %}
    </item>
    {%- endfor %}
  </channel>
</rss>
