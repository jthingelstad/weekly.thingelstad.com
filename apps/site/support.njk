---
layout: layouts/base.njk
pageTitle: Supporting Membership
description: A way to give through the Weekly Thing. 100% of membership fees go to that year's nonprofit.
permalink: /members/
---
{% import "partials/thingy-members.njk" as thingy with context %}
{{ thingy.open() }}

<div class="support-page container-narrow">
  {{ thingy.thanks() }}

  {% if support.current %}
  <section class="support-current">
    <p class="eyebrow">This year&rsquo;s nonprofit</p>
    <h2>{{ support.current.nonprofit }}</h2>
    <p>{{ support.current.description }}</p>
    {{ thingy.why() }}
    <div class="support-current-action">
      <a href="{{ support.current.url }}" class="btn btn-secondary">Visit {{ support.current.short_name or support.current.nonprofit }} &rarr;</a>
      {% if support.current.logo %}
      <img src="{{ support.current.logo }}" alt="{{ support.current.nonprofit }} logo" class="support-current-logo">
      {% endif %}
    </div>
  </section>
  {% endif %}

  {% if supportTotals.totalRaised > 0 %}
  <section class="support-impact">
    {{ thingy.record() }}
    <table class="support-table">
      <thead>
        <tr>
          <th>Year</th>
          <th>Nonprofit</th>
          <th>Raised</th>
        </tr>
      </thead>
      <tbody>
        {% if support.current and stats.amount_raised > 0 %}
        <tr>
          <td>{{ support.current.year }}</td>
          <td>
            <a href="{{ support.current.url }}" class="support-table-org">
              {% if support.current.logo %}
              <img src="{{ support.current.logo }}" alt="{{ support.current.nonprofit }} logo" class="support-table-logo">
              {% endif %}
              <span>{{ support.current.nonprofit }}</span>
            </a>
          </td>
          <td>${{ stats.amount_raised | currency }} so far</td>
        </tr>
        {% endif %}
        {% for org in support.past %}
        <tr>
          <td>{{ org.year }}</td>
          <td>
            <a href="{{ org.url }}" class="support-table-org">
              {% if org.logo %}
              <img src="{{ org.logo }}" alt="{{ org.nonprofit }} logo" class="support-table-logo">
              {% endif %}
              <span>{{ org.nonprofit }}</span>
            </a>
          </td>
          <td>{% if org.amount_raised %}${{ org.amount_raised | currency }}{% else %}&mdash;{% endif %}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </section>
  {% endif %}

  <section class="support-how" id="join">
    {{ thingy.ask() }}
    <div class="support-how-grid">
      <div class="support-how-col">
        <h3>Recurring &middot; ${{ support.yearly_price }}/year</h3>
        <p>A year of Supporting Membership is ${{ support.yearly_price }}, recurring. 100% of membership fees go to the nonprofit selected that year. Cancel anytime.</p>
        {% include "partials/upgrade-form.njk" %}
      </div>
      {% if support.current.stripe_donate_url %}
      <div class="support-how-col">
        <h3>One-Time &middot; Any amount</h3>
        <p>A single gift in any amount, with no recurring charge. 100% goes to the nonprofit selected that year. ${{ support.yearly_price }} matches a year of membership.</p>
        <p><a href="{{ support.current.stripe_donate_url }}" class="btn btn-primary" data-tinylytics-event="support.donate">Make a One-Time Gift</a></p>
      </div>
      {% endif %}
    </div>
  </section>

  <section class="support-benefits" id="benefits">
    <p class="eyebrow">What comes with it</p>
    <h2>Free for every subscriber</h2>
    <p>Subscribing to the Weekly Thing costs nothing, and it comes with more than the newsletter.</p>
    <div class="support-benefits-grid">
      {% for b in support.benefits %}{% if b.for == "everyone" %}
      <div class="support-benefit" id="benefit-{{ b.id }}">
        <h3><a href="{{ b.url }}?ref=weekly-members">{{ b.name }}</a></h3>
        <p>{{ thingy.benefit(b) }}</p>
      </div>
      {% endif %}{% endfor %}
    </div>

    <h2 class="support-benefits-members">Supporting Members also get</h2>
    {{ thingy.getYou() }}
    <p>The reason to join is the giving: 100% of membership fees go to the nonprofit selected each year. None of it pays for these. They are a thank-you on top.</p>
    <div class="support-benefits-grid">
      {% for b in support.benefits %}{% if b.for == "members" %}
      <div class="support-benefit" id="benefit-{{ b.id }}">
        <h3><a href="{{ b.url }}?ref=weekly-members">{{ b.name }}</a></h3>
        <p>{{ thingy.benefit(b) }}</p>
      </div>
      {% endif %}{% endfor %}
    </div>
  </section>

  {{ thingy.credit() }}
</div>
