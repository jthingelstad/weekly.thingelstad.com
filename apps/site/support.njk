---
layout: layouts/base.njk
pageTitle: Supporting Membership
description: Support the Weekly Thing and help fund a nonprofit each year.
permalink: /members/
---
<section class="support-hero">
  <div class="container-narrow">
    <p class="eyebrow">Membership</p>
    <h1 class="support-hero-title">Free for everyone. <em>Members fund a nonprofit</em>.</h1>
    <p class="support-hero-lede">The Weekly Thing is free for everyone, always. Supporting Members contribute to a community giving program where <strong>100% of membership fees go directly to a nonprofit</strong> selected each year.</p>
  </div>
</section>

<div class="support-page container-narrow">
  <div id="support-thanks" class="support-thanks" hidden>
    <p><strong>Thank you for your gift.</strong> 100% goes to {{ support.current.short_name or support.current.nonprofit }}. The amount-raised stat updates on the next site build.</p>
  </div>
  <script>
    if (new URLSearchParams(location.search).get('thanks') === '1') {
      document.getElementById('support-thanks').hidden = false;
    }
  </script>

  {% if support.current %}
  <section class="support-current">
    <p class="eyebrow">{{ support.current.year }} &middot; This year&rsquo;s nonprofit</p>
    <h2>{{ support.current.nonprofit }}</h2>
    <p>{{ support.current.description }}</p>
    <p><a href="{{ support.current.url }}" class="btn btn-secondary">Visit {{ support.current.short_name or support.current.nonprofit }} &rarr;</a></p>

    <div class="support-stats">
      {% if stats.amount_raised > 0 %}
      <div class="support-stat">
        <span class="stat-value">${{ stats.amount_raised | currency }}</span>
        <span class="stat-label">raised for {{ support.current.short_name or support.current.nonprofit }} this year</span>
      </div>
      {% endif %}
      {% if stats.premium_subscriber_count > 0 %}
      <div class="support-stat">
        <span class="stat-value">{{ stats.premium_subscriber_count }}</span>
        <span class="stat-label">supporting members</span>
      </div>
      {% endif %}
    </div>
  </section>
  {% endif %}

  <section class="support-how">
    <p class="eyebrow">Become a member</p>
    <h2>Support the work and the cause.</h2>
    <p>Supporting Members get a gold star recognition in each issue of the Weekly Thing. More importantly, your contribution goes directly to supporting organizations doing meaningful work.</p>
    <p><a href="https://buttondown.com/weekly-thing" class="btn btn-primary" data-tinylytics-event="support.membership">Become a Supporting Member</a></p>

    {% if support.current.stripe_donate_url %}
    <h3>One-Time Gift</h3>
    <p>Prefer to give once instead of joining as a recurring Supporting Member? Pick any amount &mdash; $48 (a year of Supporting Membership) is suggested, but anything is welcome. 100% goes to {{ support.current.short_name or support.current.nonprofit }}.</p>
    <p><a href="{{ support.current.stripe_donate_url }}" class="btn btn-secondary" data-tinylytics-event="support.donate">Make a One-Time Gift</a></p>
    {% endif %}
  </section>

  {% if support.past.length > 0 %}
  <section class="support-history">
    <p class="eyebrow">History</p>
    <h2>Past nonprofits supported</h2>
    <table class="support-table">
      <thead>
        <tr>
          <th>Year</th>
          <th>Nonprofit</th>
          <th>Raised</th>
        </tr>
      </thead>
      <tbody>
        {% for org in support.past %}
        <tr>
          <td>{{ org.year }}</td>
          <td><a href="{{ org.url }}">{{ org.nonprofit }}</a></td>
          <td>{% if org.amount_raised %}${{ org.amount_raised | currency }}{% else %}&mdash;{% endif %}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </section>
  {% endif %}
</div>
