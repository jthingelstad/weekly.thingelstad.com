---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {#- A page's <lastmod> is when what it shows last changed: the last commit
      to its own sources (_data/pageEdited.js) or the newest issue it shows,
      whichever is newer. The front page shows the newest issue, so it takes
      that issue's edit date; the archive and /podcast/ list many, so they
      take the newest edit among the issues they show; About, Search and the
      FAQ only count issues, so they take the newest send date. Never the
      build time. -#}
  {%- macro lastmod(dates) -%}{%- set d = dates | latestDate -%}{%- if d %}<lastmod>{{ d }}</lastmod>{% endif -%}{%- endmacro -%}
  {%- set newest = collections.issuesByDate[0] -%}
  {%- set newestSent = newest.data.publish_date -%}
  {%- set newestIssue = [issueEdited[newest.page.fileSlug], newestSent] | latestDate -%}
  {%- set allIssues = collections.issuesByDate | issuesLatestDate(issueEdited) -%}
  {%- set recentEpisodes = collections.podcastEpisodes | slice(0, 8) | issuesLatestDate(issueEdited) %}
  <url>
    <loc>{{ site.url }}/</loc>
    {{ lastmod([pageEdited['/'], newestIssue]) }}
    <priority>1.0</priority>
  </url>
  <url>
    <loc>{{ site.url }}/archive/</loc>
    {{ lastmod([pageEdited['/archive/'], allIssues]) }}
    <priority>0.8</priority>
  </url>
  <url>
    <loc>{{ site.url }}/topics/</loc>
    {{ lastmod([pageEdited['/topics/'], topics.newestDate]) }}
    <priority>0.7</priority>
  </url>
  <url>
    <loc>{{ site.url }}/about/</loc>
    {{ lastmod([pageEdited['/about/'], newestSent]) }}
    <priority>0.6</priority>
  </url>
  <url>
    <loc>{{ site.url }}/members/</loc>
    {{ lastmod([pageEdited['/members/']]) }}
    <priority>0.5</priority>
  </url>
  <url>
    <loc>{{ site.url }}/search/</loc>
    {{ lastmod([pageEdited['/search/'], newestSent]) }}
    <priority>0.5</priority>
  </url>
  <url>
    <loc>{{ site.url }}/podcast/</loc>
    {{ lastmod([pageEdited['/podcast/'], recentEpisodes]) }}
    <priority>0.5</priority>
  </url>
  <url>
    <loc>{{ site.url }}/faq/</loc>
    {{ lastmod([pageEdited['/faq/'], newestSent]) }}
    <priority>0.5</priority>
  </url>
  {% for issue in collections.issuesByDate %}
  <url>
    <loc>{{ site.url }}/archive/{{ issue.data.number }}/</loc>
    <lastmod>{{ issueEdited[issue.page.fileSlug] or (issue.data.publish_date | dateFormat('iso')) }}</lastmod>
    <priority>0.7</priority>
  </url>
  {% endfor %}
  {#- Topic pages are for readers, not search (Jamie, 2026-10-26: "They are
      for people, should we even include them in the sitemap?"). Google left
      most of them unindexed and spent its crawl on them, not the issues. -#}
</urlset>
