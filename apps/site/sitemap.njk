---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>{{ site.url }}/</loc>
    <priority>1.0</priority>
  </url>
  <url>
    <loc>{{ site.url }}/archive/</loc>
    <priority>0.8</priority>
  </url>
  <url>
    <loc>{{ site.url }}/topics/</loc>
    <priority>0.7</priority>
  </url>
  <url>
    <loc>{{ site.url }}/about/</loc>
    <priority>0.6</priority>
  </url>
  <url>
    <loc>{{ site.url }}/members/</loc>
    <priority>0.5</priority>
  </url>
  <url>
    <loc>{{ site.url }}/search/</loc>
    <priority>0.5</priority>
  </url>
  <url>
    <loc>{{ site.url }}/podcast/</loc>
    <priority>0.5</priority>
  </url>
<url>
    <loc>{{ site.url }}/faq/</loc>
    <priority>0.5</priority>
  </url>
  {% for issue in collections.issuesByDate %}
  <url>
    <loc>{{ site.url }}/archive/{{ issue.data.number }}/</loc>
    <lastmod>{{ issueEdited[issue.page.fileSlug] or (issue.data.publish_date | dateFormat('iso')) }}</lastmod>
    <priority>0.7</priority>
  </url>
  {% endfor %}
  {#- Topic pages are for readers, not search (Jamie, 2026-10-26: "They are
      for people, should we even include them in the sitemap?"). Google left
      most of them unindexed and spent its crawl on them, not the issues. -#}
</urlset>
