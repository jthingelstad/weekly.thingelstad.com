---
pagination:
  data: collections.issuesByNumber
  size: 1
  alias: issue
permalink: /archive/{{ issue.data.number }}/links.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>Links from {{ issue.data.subject | xmlEscape }}</title>
  <subtitle>Links featured in WT{{ issue.data.number }} of the Weekly Thing</subtitle>
  <link href="{{ site.url }}/archive/{{ issue.data.number }}/links.xml" rel="self" type="application/atom+xml"/>
  <link href="{{ site.url }}/archive/{{ issue.data.number }}/" rel="alternate" type="text/html"/>
  {#- Ids are tag: URIs (RFC 4151), not addresses. Until 2026-11-23 they were
      the site's address plus /archive/N/links/M, which is no page, and
      crawlers fetched each one: about 6,000 404s a day. The host and year
      are fixed so an id never changes; M is the link's place in the issue. #}
  <id>tag:weekly.thingelstad.com,2026:wt{{ issue.data.number }}-links</id>
  <author>
    <name>{{ site.author }}</name>
  </author>
  <updated>{{ issue.data.publish_date | dateFormat('iso') }}</updated>
  {% for link in issue.data.links %}
  <entry>
    <title>{{ (link.text or link.url) | xmlEscape }}</title>
    <link href="{{ link.url | xmlEscape }}"/>
    <id>tag:weekly.thingelstad.com,2026:wt{{ issue.data.number }}-link-{{ loop.index }}</id>
    <published>{{ issue.data.publish_date | dateFormat('iso') }}</published>
    <updated>{{ issue.data.publish_date | dateFormat('iso') }}</updated>
    {% if link.heading_context %}
    {%- set headingText = link.heading_context | headingText %}
    {%- set headingUrl = link.heading_context | headingUrl %}
    <summary type="text">From "{{ headingText | xmlEscape }}" in {{ issue.data.subject | xmlEscape }}</summary>
    <content type="html">&lt;p&gt;From "{% if headingUrl %}&lt;a href="{{ headingUrl | htmlEscape | xmlEscape }}"&gt;{{ headingText | htmlEscape | xmlEscape }}&lt;/a&gt;{% else %}{{ headingText | htmlEscape | xmlEscape }}{% endif %}" in {{ issue.data.subject | htmlEscape | xmlEscape }}&lt;/p&gt;&lt;img src="https://tinylytics.app/pixel/{{ site.tinylyticsId }}.gif?path=/feed-links/{{ issue.data.number }}/" alt="" width="1" height="1" style="border:0" /&gt;</content>
    {% endif %}
  </entry>
  {% endfor %}
</feed>
