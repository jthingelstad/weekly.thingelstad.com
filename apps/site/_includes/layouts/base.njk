<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ subject or pageTitle or title }}{% if subject or pageTitle %} — {{ site.title }}{% endif %}</title>
  <meta name="description" content="{{ description or site.description }}">

  {# Open Graph #}
  <meta property="og:title" content="{{ subject or pageTitle or title or site.title }}">
  <meta property="og:description" content="{{ description or site.description }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:type" content="{{ ogType or 'website' }}">
  <meta property="og:site_name" content="{{ site.title }}">
  {% if image %}
  <meta property="og:image" content="{{ image }}">
  <meta name="twitter:image" content="{{ image }}">
  {% endif %}
  <meta name="twitter:card" content="{{ 'summary_large_image' if image else 'summary' }}">
  <meta name="twitter:title" content="{{ subject or pageTitle or title or site.title }}">
  <meta name="twitter:description" content="{{ description or site.description }}">
  {% if publish_date %}
  <meta property="article:published_time" content="{{ publish_date | dateFormat('iso') }}">
  <meta property="article:author" content="{{ site.author }}">
  {% endif %}

  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="license" href="https://creativecommons.org/licenses/by-sa/4.0/">
  <link rel="webmention" href="https://tinylytics.app/webmention/{{ site.tinylyticsId }}">

  {# Web fonts #}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Source+Serif+4:ital,opsz,wght@0,8..60,400..600;1,8..60,400..600&family=Source+Sans+3:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap">

  {# RSS feed discovery #}
  <link rel="alternate" type="application/atom+xml" title="{{ site.title }}" href="/feed.xml">
  <link rel="alternate" type="application/rss+xml" title="{{ site.title }} Podcast" href="/podcast.xml">
  {# Machine-readable discovery #}
  <link rel="alternate" type="text/markdown" title="LLM-friendly site index" href="/llms.txt">
  <link rel="alternate" type="application/json" title="Archive index (JSON)" href="/archive.json">
  {% if number %}
  <link rel="alternate" type="text/markdown" title="Markdown version" href="/archive/{{ number }}.txt">
  {% endif %}
  {% block head %}{% endblock %}

  <link rel="stylesheet" href="/css/style.css?v={{ assets.cssVersion }}">
</head>
<body>
  <a href="#main-content" class="skip-link">Skip to content</a>
  {% include "partials/header.njk" %}

  <main id="main-content">
    {% block content %}
      {{ content | safe }}
    {% endblock %}
  </main>

  {% include "partials/footer.njk" %}
  <script>
    (function() {
      if (['localhost', '127.0.0.1', '::1'].includes(window.location.hostname)) return;
      var script = document.createElement('script');
      script.defer = true;
      script.src = 'https://tinylytics.app/embed/{{ site.tinylyticsId }}.js?kudos=custom&hits&countries&events&beacon';
      document.body.appendChild(script);
    })();
  </script>
</body>
</html>
