<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ subject or pageTitle or title }}{% if subject or pageTitle %} — {{ site.title }}{% endif %}</title>
  <meta name="description" content="{{ description or site.description }}">

  {# Open Graph #}
  <meta property="og:title" content="{{ subject or pageTitle or title or site.title }}">
  <meta property="og:description" content="{{ description or site.description }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:type" content="{{ ogType or 'website' }}">
  <meta property="og:site_name" content="{{ site.title }}">
  {# An issue's own image; else a topic's newest cover; else, on a page
     that isn't an issue, the newest issue's cover (_data/defaultShareImage.js).
     An issue with no cover of its own (49 early ones) shares none, rather
     than another issue's. #}
  {% set shareImage = image or topic.image or (defaultShareImage if not number) %}
  {% if shareImage %}
  <meta property="og:image" content="{{ shareImage }}">
  <meta name="twitter:image" content="{{ shareImage }}">
  {% endif %}
  <meta name="twitter:card" content="{{ 'summary_large_image' if shareImage else 'summary' }}">
  <meta name="twitter:title" content="{{ subject or pageTitle or title or site.title }}">
  <meta name="twitter:description" content="{{ description or site.description }}">
  {% if publish_date %}
  <meta property="article:published_time" content="{{ publish_date | dateFormat('iso') }}">
  <meta property="article:author" content="{{ site.author }}">
  {% endif %}

  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  <link rel="icon" href="/favicon.svg?v={{ assets.faviconVersion }}" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png?v={{ assets.touchIconVersion }}">
  {# Jamie's identity links, the same on every one of his sites (sites.json owner.rel_me). #}
  {% for meUrl in sites.owner.rel_me %}
  <link rel="me" href="{{ meUrl }}">
  {% endfor %}
  <link rel="license" href="https://creativecommons.org/licenses/by-sa/4.0/">
  <link rel="webmention" href="https://tinylytics.app/webmention/{{ site.tinylyticsId }}">

  {# The type every one of Jamie's sites shares: Inter and Inter Tight,
     self-hosted, and the --jt- tokens (css/shared/, vendored from
     thingelstad.com shared/ by npm run sites:sync). #}
  <link rel="preload" href="/css/shared/fonts/inter-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/css/shared/fonts/inter-tight-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/css/shared/tokens.css?v={{ assets.sharedCssVersion }}">

  {# RSS feed discovery #}
  <link rel="alternate" type="application/atom+xml" title="{{ site.title }}" href="/feed.xml">
  <link rel="alternate" type="application/feed+json" title="{{ site.title }}" href="/feed.json">
  <link rel="alternate" type="application/rss+xml" title="{{ site.title }} Podcast" href="/podcast.xml">
  {# Machine-readable discovery #}
  <link rel="alternate" type="text/markdown" title="LLM-friendly site index" href="/llms.txt">
  <link rel="alternate" type="application/json" title="Archive index (JSON)" href="/archive.json">
  {% if number %}
  <link rel="alternate" type="text/markdown" title="Markdown version" href="/archive/{{ number }}.txt">
  {% endif %}
  {% block head %}{% endblock %}

  <link rel="stylesheet" href="/css/style.css?v={{ assets.cssVersion }}">
</head>
<body>
  {% include "partials/attribution-capture.njk" %}
  {% include "partials/turnstile.njk" %}
  <a href="#main-content" class="skip-link">Skip to content</a>
  {% include "partials/sites-strip.njk" %}
  {% include "partials/header.njk" %}

  <main id="main-content">
    {% block content %}
      {{ content | safe }}
    {% endblock %}
  </main>

  {% include "partials/footer.njk" %}
  <script>
    (function() {
      if (['localhost', '127.0.0.1', '::1'].includes(window.location.hostname)) return;
      var script = document.createElement('script');
      script.defer = true;
      script.src = 'https://tinylytics.app/embed/{{ site.tinylyticsId }}.js?kudos=custom&hits&countries&events&beacon';
      document.body.appendChild(script);
    })();
  </script>
</body>
</html>
