---
layout: layouts/base.njk
ogType: article
---
{%- set pageTitle = subject -%}
{%- set allIssues = collections.issuesByNumber -%}
{%- set currentIndex = -1 -%}
{%- for item in allIssues -%}
  {%- if item.data.number == number -%}
    {%- set currentIndex = loop.index0 -%}
  {%- endif -%}
{%- endfor -%}
{%- set prev1 = allIssues[currentIndex - 1] if currentIndex > 0 else null -%}
{%- set next1 = allIssues[currentIndex + 1] if currentIndex >= 0 and currentIndex < allIssues.length - 1 else null -%}
{%- set toc = content | extractToc -%}
{%- set readMinutes = (word_count / 200) | round if word_count else 0 -%}
{%- set listenSeconds = audio_duration_seconds or 0 -%}
{%- set listenMinutes = (listenSeconds / 60) | int -%}
{%- set listenSecondsRem = listenSeconds - (listenMinutes * 60) -%}

{% block head %}
  <link rel="alternate" type="application/atom+xml" title="Links from Issue #{{ number }}" href="/archive/{{ number }}/links.xml">
{% endblock %}

<article class="issue" data-pagefind-body>
  {# Top issue chrome — Archive crumb + arrow pager #}
  <div class="issue-bar">
    <div class="container-wide">
      <div class="issue-bar-inner">
        <a href="/archive/" class="issue-back">&larr; Archive</a>
        <div class="issue-pager">
          {% if prev1 %}<a href="/archive/{{ prev1.data.number }}/" class="issue-pager-btn" title="Issue {{ prev1.data.number }}: {{ prev1.data.subject }}">&lsaquo; #{{ prev1.data.number }}</a>{% endif %}
          <span class="issue-pager-here" aria-current="page">#{{ number }}</span>
          {% if next1 %}<a href="/archive/{{ next1.data.number }}/" class="issue-pager-btn" title="Issue {{ next1.data.number }}: {{ next1.data.subject }}">#{{ next1.data.number }} &rsaquo;</a>{% endif %}
        </div>
      </div>
    </div>
  </div>

  <header class="issue-hero">
    <div class="container-narrow">
      <p class="eyebrow">Weekly Thing #<span data-pagefind-meta="issue">{{ number }}</span> &middot; <time datetime="{{ publish_date | dateFormat('iso') }}" data-pagefind-meta="date">{{ publish_date | dateFormat }}</time></p>
      {%- set titleParts = subject | split(" / ") -%}
      <h1 class="issue-title" data-pagefind-meta="title">{{ titleParts | last if titleParts.length > 1 else subject }}</h1>
      {% if description %}
      <p class="issue-dek">{{ description }}</p>
      {% endif %}
      <div class="issue-byline">
        <img src="/img/jamie-thingelstad.jpg" alt="" class="issue-byline-avatar" loading="lazy" width="44" height="44">
        <div>
          <div class="issue-byline-name">Jamie Thingelstad</div>
          <div class="issue-byline-meta">
            {% if word_count %}{{ word_count | numberFormat }} words{% if readMinutes > 0 %} &middot; ~{{ readMinutes }} min read{% endif %}{% endif %}{% if listenSeconds > 0 %} &middot; {{ listenMinutes }}:{% if listenSecondsRem < 10 %}0{% endif %}{{ listenSecondsRem }} listen{% endif %}
          </div>
        </div>
        <div class="issue-byline-actions">
          <button class="tinylytics_kudos issue-action issue-action-kudos" data-path="/archive/{{ number }}/" aria-label="Kudos"></button>
          <button class="share-button issue-action" data-url="{{ site.url }}/archive/{{ number }}/" data-title="{{ subject }}" data-tinylytics-event="issue.share" data-tinylytics-event-value="{{ number }}">
            <span aria-hidden="true">&#8599;</span>
            <span class="share-label">Share</span>
          </button>
          {% if audio_url %}
          <button type="button" class="issue-action issue-action-primary issue-listen" data-audio-url="{{ audio_url }}" data-tinylytics-event="issue.listen" data-tinylytics-event-value="{{ number }}">
            <span class="issue-listen-icon" aria-hidden="true">&#9656;</span>
            <span class="issue-listen-label">Listen</span>
          </button>
          <audio class="issue-listen-audio" preload="none" src="{{ audio_url }}" hidden>
            <a href="{{ audio_url }}">Download the MP3</a>
          </audio>
          {% endif %}
        </div>
      </div>
    </div>
  </header>

  <div class="issue-layout container-wide">
    <aside class="issue-toc">
      {% if toc.length > 0 %}
      <details class="issue-toc-section" open>
        <summary class="eyebrow">In this issue</summary>
        <ol class="issue-toc-list">
          {% for heading in toc %}
          <li class="issue-toc-item issue-toc-level-{{ heading.level }}">
            <a href="#{{ heading.id }}">{{ heading.text }}</a>
          </li>
          {% endfor %}
        </ol>
      </details>
      {% endif %}

      {%- set issueTopicSlugs = topics.byIssue[number | string] -%}
      {%- if issueTopicSlugs and issueTopicSlugs.length > 0 -%}
      <details class="issue-topics-section" open>
        <summary class="eyebrow">Topics</summary>
        <ul class="issue-topics-list">
          {%- for slug in issueTopicSlugs -%}
            {%- set topic = topics.bySlug[slug] -%}
            {%- if topic -%}
            <li class="issue-topics-item">
              <a href="/topics/{{ topic.slug }}/">{{ topic.name }}</a>
            </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </details>
      {%- endif -%}

    </aside>

    <div class="issue-content">
      {{ content | safe }}
    </div>
  </div>

  <section class="issue-cta-foot">
    <div class="container-narrow">
      <p class="eyebrow">Subscribe</p>
      {% set subscribeId = "issue" %}
      {% include "partials/subscribe-form.njk" %}
    </div>
  </section>
</article>
<script>
(function() {
  var shareButton = document.querySelector('.share-button');
  if (shareButton) {
    shareButton.addEventListener('click', function() {
      var btn = this;
      var url = btn.dataset.url;
      var title = btn.dataset.title;
      var label = btn.querySelector('.share-label');
      var originalLabel = label ? label.textContent : btn.textContent;
      if (navigator.share) {
        navigator.share({ title: title, url: url });
      } else if (navigator.clipboard) {
        navigator.clipboard.writeText(url).then(function() {
          if (label) {
            label.textContent = 'Copied';
            setTimeout(function() { label.textContent = originalLabel; }, 2000);
          }
        });
      }
    });
  }

  // Collapse the sidebar sections by default on narrow viewports so the
  // article body isn't pushed below a long list of headings/domains.
  if (window.matchMedia && window.matchMedia('(max-width: 960px)').matches) {
    document.querySelectorAll('.issue-toc-section[open]').forEach(function(d) {
      d.removeAttribute('open');
    });
  }

  var listenButton = document.querySelector('.issue-listen');
  var listenAudio = document.querySelector('.issue-listen-audio');
  if (listenButton && listenAudio) {
    var icon = listenButton.querySelector('.issue-listen-icon');
    var label = listenButton.querySelector('.issue-listen-label');
    listenAudio.hidden = false;
    listenAudio.style.display = 'none';
    listenButton.addEventListener('click', function() {
      if (listenAudio.paused) {
        listenAudio.play();
      } else {
        listenAudio.pause();
      }
    });
    listenAudio.addEventListener('play', function() {
      if (icon) icon.textContent = '⏸';
      if (label) label.textContent = 'Pause';
      listenButton.classList.add('is-playing');
    });
    listenAudio.addEventListener('pause', function() {
      if (icon) icon.textContent = '▶';
      if (label) label.textContent = 'Listen';
      listenButton.classList.remove('is-playing');
    });
    listenAudio.addEventListener('ended', function() {
      if (icon) icon.textContent = '▶';
      if (label) label.textContent = 'Listen';
      listenButton.classList.remove('is-playing');
    });
  }
})();
</script>
