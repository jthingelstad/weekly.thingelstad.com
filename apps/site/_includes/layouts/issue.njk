---
layout: layouts/base.njk
ogType: article
---
{%- set pageTitle = subject -%}
{%- set allIssues = collections.issuesByNumber -%}
{%- set currentIndex = -1 -%}
{%- for item in allIssues -%}
  {%- if item.data.number == number -%}
    {%- set currentIndex = loop.index0 -%}
  {%- endif -%}
{%- endfor -%}
{%- set prev1 = allIssues[currentIndex - 1] if currentIndex > 0 else null -%}
{%- set next1 = allIssues[currentIndex + 1] if currentIndex >= 0 and currentIndex < allIssues.length - 1 else null -%}
{%- set toc = content | extractToc -%}
{%- set readMinutes = (word_count / 200) | round if word_count else 0 -%}
{%- set listenSeconds = audio_duration_seconds or 0 -%}
{%- set listenMinutes = (listenSeconds / 60) | int -%}
{%- set listenSecondsRem = listenSeconds - (listenMinutes * 60) -%}

{% block head %}
  <link rel="alternate" type="application/atom+xml" title="Links from WT{{ number }}" href="/archive/{{ number }}/links.xml">
{% endblock %}

<article class="issue" data-pagefind-body>
  {# Top issue chrome — Archive crumb + arrow pager #}
  <div class="issue-bar">
    <div class="container-wide">
      <div class="issue-bar-inner">
        <a href="/archive/" class="issue-back">&larr; Archive</a>
        <div class="issue-pager">
          {% if prev1 %}<a href="/archive/{{ prev1.data.number }}/" class="issue-pager-btn" title="WT{{ prev1.data.number }}: {{ prev1.data.subject }}">&lsaquo; WT{{ prev1.data.number }}</a>{% endif %}
          <span class="issue-pager-here" aria-current="page">WT{{ number }}</span>
          {% if next1 %}<a href="/archive/{{ next1.data.number }}/" class="issue-pager-btn" title="WT{{ next1.data.number }}: {{ next1.data.subject }}">WT{{ next1.data.number }} &rsaquo;</a>{% endif %}
        </div>
      </div>
    </div>
  </div>

  <header class="issue-hero">
    <div class="container-narrow">
      <p class="eyebrow">Weekly Thing <span data-pagefind-meta="issue">{{ number }}</span> &middot; <time datetime="{{ publish_date | dateFormat('iso') }}" data-pagefind-meta="date">{{ publish_date | dateFormat }}</time></p>
      {%- set displayTitle = subject -%}
      {%- if " — " in displayTitle -%}{%- set displayTitle = displayTitle | split(" — ") | last -%}{%- elif " / " in displayTitle -%}{%- set displayTitle = displayTitle | split(" / ") | last -%}{%- endif -%}
      <h1 class="issue-title" data-pagefind-meta="title">{{ displayTitle }}</h1>
      {% if description %}
      <p class="issue-dek">{{ description }}</p>
      {% endif %}
      <div class="issue-byline">
        <img src="/img/jamie-thingelstad.jpg" alt="" class="issue-byline-avatar" loading="lazy" width="44" height="44">
        <div>
          <div class="issue-byline-name">Jamie Thingelstad</div>
          <div class="issue-byline-meta">
            {% if word_count %}{{ word_count | numberFormat }} words{% if readMinutes > 0 %} &middot; ~{{ readMinutes }} min read{% endif %}{% endif %}{% if listenSeconds > 0 %} &middot; {{ listenMinutes }}:{% if listenSecondsRem < 10 %}0{% endif %}{{ listenSecondsRem }} listen{% endif %}
          </div>
        </div>
        <div class="issue-byline-actions">
          <button class="tinylytics_kudos issue-action issue-action-kudos" data-path="/archive/{{ number }}/" aria-label="Kudos"></button>
          <a class="issue-action issue-action-explore" target="_blank" rel="noopener" href="{{ site.thingyUrl }}/chat/?issue={{ number }}" data-tinylytics-event="issue.explore" data-tinylytics-event-value="{{ number }}">
            <span aria-hidden="true">&#10024;</span>
            <span>Explore with Thingy</span>
          </a>
          <button class="share-button issue-action" data-url="{{ site.url }}/archive/{{ number }}/" data-title="{{ subject }}" data-tinylytics-event="issue.share" data-tinylytics-event-value="{{ number }}">
            <span aria-hidden="true">&#8599;</span>
            <span class="share-label">Share</span>
          </button>
          {% if audio_url %}
          <button type="button" class="issue-action issue-action-primary issue-listen" data-audio-url="{{ audio_url }}" data-tinylytics-event="issue.listen" data-tinylytics-event-value="{{ number }}">
            <span class="issue-listen-icon" aria-hidden="true">▶️</span>
            <span class="issue-listen-label">Listen</span>
          </button>
          <audio class="issue-listen-audio" preload="none" src="{{ audio_url }}" hidden>
            <a href="{{ audio_url }}">Download the MP3</a>
          </audio>
          {% endif %}
        </div>
      </div>
    </div>
  </header>

  <div class="issue-layout container-wide">
    <aside class="issue-toc">
      {% if toc.length > 0 %}
      <details class="issue-toc-section" open>
        <summary class="eyebrow">In this issue</summary>
        <ol class="issue-toc-list">
          {% for heading in toc %}
          <li class="issue-toc-item issue-toc-level-{{ heading.level }}">
            <a href="#{{ heading.id }}">{{ heading.text }}</a>
          </li>
          {% endfor %}
        </ol>
      </details>
      {% endif %}

      {%- if audio_url and audio_chapters and audio_chapters.length > 0 -%}
      {#- The audio edition's chapters, as WT Builder placed them: the time
          seeks the player; a chapter that is a link goes to the link. -#}
      <details class="issue-toc-section issue-chapters-section">
        <summary class="eyebrow">Listen by chapter</summary>
        <ol class="issue-chapter-list">
          {%- for chapter in audio_chapters -%}
          <li class="issue-chapter" data-start="{{ chapter.start }}">
            <button type="button" class="issue-chapter-seek" data-start="{{ chapter.start }}" aria-label="Play from {{ chapter.start | clock }}">{{ chapter.start | clock }}</button>
            {%- if chapter.url and chapter.url != (site.url + '/archive/' + (number | string) + '/') -%}
            <a class="issue-chapter-title" href="{{ chapter.url }}" target="_blank" rel="noopener">{{ chapter.title }}</a>
            {%- else -%}
            <span class="issue-chapter-title">{{ chapter.title }}</span>
            {%- endif -%}
          </li>
          {%- endfor -%}
        </ol>
      </details>
      {%- endif -%}

      {%- set issueTopicSlugs = topics.byIssue[number | string] -%}
      {%- if issueTopicSlugs and issueTopicSlugs.length > 0 -%}
      <details class="issue-topics-section" open>
        <summary class="eyebrow">Topics</summary>
        <ul class="issue-topics-list">
          {%- for slug in issueTopicSlugs -%}
            {%- set topic = topics.bySlug[slug] -%}
            {%- if topic -%}
            <li class="issue-topics-item">
              <a href="/topics/{{ topic.slug }}/">{{ topic.name }}</a>
            </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </details>
      {%- endif -%}

    </aside>

    <div class="issue-content">
      {{ content | safe }}

      {%- if audio_url and audio_transcript_url -%}
      {#- The spoken script, timed. Fetched from the CDN when opened; each cue
          seeks the player and the one being spoken is highlighted. Speaker
          labels come from the file — Thingy is attributed in text as in voice. -#}
      <details class="issue-transcript" data-transcript-url="{{ audio_transcript_url }}">
        <summary><span class="eyebrow">Transcript</span> <span class="issue-transcript-note">of the audio edition{% if audio_duration_seconds %} · {{ audio_duration_seconds | clock }}{% endif %}</span></summary>
        <div class="issue-transcript-body" aria-live="polite"><p class="issue-transcript-loading">Loading…</p></div>
        <p class="issue-transcript-foot"><a href="{{ audio_url }}">Download the MP3</a>{% if audio_chapters_url %} · <a href="{{ audio_chapters_url }}">Chapters</a>{% endif %} · <a href="{{ audio_transcript_url }}">WebVTT</a></p>
      </details>
      {%- endif -%}
    </div>
  </div>

  <section class="issue-cta-foot">
    <div class="container-narrow">
      <p class="eyebrow">Subscribe</p>
      {% set subscribeId = "issue" %}
      {% include "partials/subscribe-form.njk" %}
    </div>
  </section>
</article>
<script>
(function() {
  var shareButton = document.querySelector('.share-button');
  if (shareButton) {
    shareButton.addEventListener('click', function() {
      var btn = this;
      var url = btn.dataset.url;
      var title = btn.dataset.title;
      var label = btn.querySelector('.share-label');
      var originalLabel = label ? label.textContent : btn.textContent;
      if (navigator.share) {
        navigator.share({ title: title, url: url });
      } else if (navigator.clipboard) {
        navigator.clipboard.writeText(url).then(function() {
          if (label) {
            label.textContent = 'Copied';
            setTimeout(function() { label.textContent = originalLabel; }, 2000);
          }
        });
      }
    });
  }

  // Collapse the sidebar sections by default on narrow viewports so the
  // article body isn't pushed below a long list of headings/domains.
  if (window.matchMedia && window.matchMedia('(max-width: 960px)').matches) {
    document.querySelectorAll('.issue-toc-section[open]').forEach(function(d) {
      d.removeAttribute('open');
    });
  }

  var listenButton = document.querySelector('.issue-listen');
  var listenAudio = document.querySelector('.issue-listen-audio');
  if (listenButton && listenAudio) {
    var icon = listenButton.querySelector('.issue-listen-icon');
    var label = listenButton.querySelector('.issue-listen-label');
    listenAudio.hidden = false;
    listenAudio.style.display = 'none';
    listenButton.addEventListener('click', function() {
      if (listenAudio.paused) {
        listenAudio.play();
      } else {
        listenAudio.pause();
      }
    });
    listenAudio.addEventListener('play', function() {
      if (icon) icon.textContent = '⏸';
      if (label) label.textContent = 'Pause';
      listenButton.classList.add('is-playing');
      // Closed by default — 36 chapters is a tall list — and open once
      // someone is actually listening.
      var chapterSection = document.querySelector('.issue-chapters-section');
      if (chapterSection) chapterSection.open = true;
    });
    listenAudio.addEventListener('pause', function() {
      if (icon) icon.textContent = '▶';
      if (label) label.textContent = 'Listen';
      listenButton.classList.remove('is-playing');
    });
    listenAudio.addEventListener('ended', function() {
      if (icon) icon.textContent = '▶';
      if (label) label.textContent = 'Listen';
      listenButton.classList.remove('is-playing');
    });

    var seekTo = function(seconds) {
      var go = function() { listenAudio.currentTime = seconds; listenAudio.play(); };
      if (listenAudio.readyState >= 1) go();
      else { listenAudio.addEventListener('loadedmetadata', go, { once: true }); listenAudio.load(); }
    };

    // Chapters: the time seeks; the one playing is marked.
    var chapters = Array.prototype.slice.call(document.querySelectorAll('.issue-chapter'));
    chapters.forEach(function(li) {
      var seek = li.querySelector('.issue-chapter-seek');
      if (seek) seek.addEventListener('click', function() { seekTo(Number(li.dataset.start)); });
    });

    // Transcript: fetched once, when the reader opens it.
    var transcript = document.querySelector('.issue-transcript');
    var cues = [];
    if (transcript) {
      var loaded = false;
      transcript.addEventListener('toggle', function() {
        if (!transcript.open || loaded) return;
        loaded = true;
        var body = transcript.querySelector('.issue-transcript-body');
        fetch(transcript.dataset.transcriptUrl).then(function(r) { return r.text(); }).then(function(vtt) {
          body.innerHTML = '';
          var toSeconds = function(t) {
            var p = t.split(':'); return Number(p[0]) * 3600 + Number(p[1]) * 60 + Number(p[2]);
          };
          var lastSpeaker = null;
          vtt.split(/\n\n+/).forEach(function(block) {
            var m = /(\d\d:\d\d:\d\d\.\d{3}) --> (\d\d:\d\d:\d\d\.\d{3})\n<v ([^>]+)>([\s\S]*)/.exec(block);
            if (!m) return;
            var p = document.createElement('p');
            p.className = 'issue-cue' + (m[3] === 'Thingy' ? ' issue-cue-thingy' : '');
            p.dataset.start = String(toSeconds(m[1]));
            p.dataset.end = String(toSeconds(m[2]));
            if (m[3] !== lastSpeaker) {
              var who = document.createElement('span');
              who.className = 'issue-cue-speaker';
              who.textContent = m[3];
              p.appendChild(who);
              lastSpeaker = m[3];
            }
            var text = document.createElement('span');
            text.textContent = m[4].trim();
            p.appendChild(text);
            p.addEventListener('click', function() { seekTo(Number(p.dataset.start)); });
            body.appendChild(p);
            cues.push(p);
          });
        }).catch(function() {
          body.innerHTML = '<p class="issue-transcript-loading">The transcript could not be loaded.</p>';
        });
      });
    }

    listenAudio.addEventListener('timeupdate', function() {
      var t = listenAudio.currentTime;
      var current = null;
      chapters.forEach(function(li) { if (Number(li.dataset.start) <= t) current = li; });
      chapters.forEach(function(li) { li.classList.toggle('is-current', li === current); });
      cues.forEach(function(p) {
        p.classList.toggle('is-current', Number(p.dataset.start) <= t && t < Number(p.dataset.end));
      });
    });
  }
})();
</script>
