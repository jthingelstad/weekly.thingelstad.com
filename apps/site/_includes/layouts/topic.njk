---
layout: layouts/base.njk
---
<article class="topic">
  <header class="topic-header">
    <p class="eyebrow">Topic</p>
    <h1>{{ topic.name }}</h1>
    <p class="topic-stat">
      Mentioned in <strong>{{ topic.count | numberFormat }}</strong>
      {% if topic.count == 1 %}issue{% else %}issues{% endif %}{% if topic.firstDate and topic.lastDate %},
      from {{ topic.firstDate | dateFormat('MMM yyyy') }} to {{ topic.lastDate | dateFormat('MMM yyyy') }}{% endif %}.
    </p>
  </header>

  <section class="topic-issues archive-list-wrap">
    <h2 class="eyebrow">Issues</h2>
    <ol class="archive-list">
      {%- for it in topic.issues -%}
      <li class="archive-entry">
        <div class="archive-entry-link">
          {% set hasCover = it.image and ("files.thingelstad.com" in it.image) %}
          <div class="archive-entry-cover" aria-hidden="true"{% if hasCover %} style="background-image: linear-gradient(180deg, transparent 55%, rgba(0,0,0,0.45)), url('{{ it.image }}'); background-size: cover; background-position: center;"{% else %} data-fallback="{{ it.number }}"{% endif %}>
            <span class="archive-entry-cover-num">WT{{ it.number }}</span>
          </div>
          <div class="archive-entry-body">
            <h3 class="archive-entry-title"><a href="/archive/{{ it.number }}/" class="archive-entry-stretched">{{ it.subject }}</a></h3>
            {% if it.description %}
            <p class="archive-entry-description">{{ it.description }}</p>
            {% endif %}
            <p class="archive-entry-foot">
              <time datetime="{{ it.publish_date | dateFormat('iso') }}">{{ it.publish_date | dateShort }}</time>
              {% if it.links and it.links.length > 0 %}<span><strong>{{ it.links.length }}</strong> links</span>{% endif %}
              {% if it.word_count %}<span><strong>{{ (it.word_count / 1000) | round(1) }}k</strong> words</span>{% endif %}
              {% if it.audio_url %}<a href="{{ it.audio_url }}" class="archive-entry-action archive-entry-listen" data-audio-url="{{ it.audio_url }}" data-issue="{{ it.number }}" data-tinylytics-event="topic.listen" data-tinylytics-event-value="{{ it.number }}">▶️ Listen &rarr;</a>{% endif %}
              <a href="{{ site.thingyUrl }}/chat/?issue={{ it.number }}" target="_blank" rel="noopener" class="archive-entry-action archive-entry-chat" data-tinylytics-event="topic.chat" data-tinylytics-event-value="{{ it.number }}">💬 Chat &rarr;</a>
            </p>
          </div>
        </div>
      </li>
      {%- endfor -%}
    </ol>
  </section>

  <script>
  (function() {
    // Same deterministic gradient palette as the main archive page so
    // the fallback covers visually match across surfaces.
    var palette = [
      'linear-gradient(135deg, #1a3a5c 0%, #2a4d3a 60%, #c44d2b 100%)',
      'linear-gradient(160deg, #d97757 0%, #8a3815 100%)',
      'linear-gradient(135deg, #2a4d3a 0%, #14181f 100%)',
      'linear-gradient(135deg, #f4ede0 0%, #d8cdb6 50%, #7a6f5f 100%)',
      'linear-gradient(135deg, #1f6fd6 0%, #134d99 100%)',
      'linear-gradient(135deg, #c44d2b 0%, #6a1b1b 100%)',
      'linear-gradient(135deg, #5a4a8a 0%, #2a1a4a 100%)'
    ];
    document.querySelectorAll('.topic-issues .archive-entry-cover[data-fallback]').forEach(function(el) {
      var n = parseInt(el.dataset.fallback, 10) || 0;
      el.style.background = palette[n % palette.length];
    });
  })();
  </script>

  <aside class="topic-thingy">
    <p class="topic-thingy-lede">
      Want to go deeper on <em>{{ topic.name }}</em>?
      <a class="topic-thingy-link" target="_blank" rel="noopener" href="{{ site.thingyUrl }}/chat/?prompt={{ ('Tell me about ' + topic.name + ' in The Weekly Thing.') | urlencode }}&from={{ (site.url + '/topics/' + topic.slug + '/') | urlencode }}" data-tinylytics-event="topic.thingy_nudge" data-tinylytics-event-value="{{ topic.slug }}">Ask Thingy →</a>
    </p>
  </aside>

  {%- if topic.related and topic.related.length > 0 -%}
  <section class="topic-related">
    <h2 class="eyebrow">Related topics</h2>
    <ul class="topic-related-list">
      {%- for r in topic.related -%}
      <li class="topic-related-item">
        <a href="/topics/{{ r.slug }}/">{{ r.name }}</a>
        <span class="topic-related-co">{{ r.coMentions }}</span>
      </li>
      {%- endfor -%}
    </ul>
  </section>
  {%- endif -%}

  <nav class="topic-foot-nav">
    <a href="/topics/">← All topics</a>
  </nav>
</article>
