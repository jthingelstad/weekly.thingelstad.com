<header class="site-header">
  <div class="container-wide">
    <a href="/" class="site-logo">
      {# The W mark: the favicon's Source Serif 4 bold italic W, as a path, so the
         serif needs no font of its own. #}
      <svg class="site-logo-mark" aria-hidden="true" viewBox="0 0 32 32" width="26" height="26"><circle class="site-logo-mark__ground" cx="16" cy="16" r="16"/><path fill="#fff" d="M8.61 10.6 6 10.45 6.27 9.14H12.47L12.19 10.45L9.73 10.6ZM8.5 22.86 7.19 9.14H10.67L11.23 20.5H11.17L11.99 17.71L15.66 9.14H18.18L19.22 20.5H19.18L19.89 17.71L23.41 9.14H24.94L19.06 22.86H16.45L15.36 12.04H15.64L14.84 14.52L11.15 22.86ZM16.14 10.6 13.63 10.45 13.9 9.14H20.14L19.87 10.45L17.37 10.6ZM23.14 10.6 21.39 10.45 21.66 9.14H26L25.73 10.45L23.89 10.6Z"/></svg>
      <span>Weekly Thing</span>
    </a>
    <nav class="site-nav" aria-label="Main navigation">
      {# Thingy is another site, so it sits last, opens in a new tab, and says so. #}
      {% set navItems = [
        { href: "/", label: "Home" },
        { href: "/archive/", label: "Archive" },
        { href: "/podcast/", label: "Podcast" },
        { href: "/topics/", label: "Topics" },
        { href: "/search/", label: "Search" },
        { href: "/about/", label: "About" },
        { href: "/members/", label: "Members" },
        { href: site.thingyUrl + "/?ref=weekly-nav", label: "Thingy", external: true }
      ] %}
      {% for item in navItems %}
      {% set isActive = (not item.external) and (page.url | isActiveNav(item.href)) %}
      {% if item.external %}
      <a href="{{ item.href }}" class="is-external" target="_blank" rel="noopener">{{ item.label }}<svg class="ext-glyph" aria-hidden="true" viewBox="0 0 12 12" width="10" height="10"><path d="M4.5 2H2v8h8V7.5M7 2h3v3M10 2 5.5 6.5" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg><span class="sr-only"> (opens in a new tab)</span></a>
      {% else %}
      <a href="{{ item.href }}"{% if isActive %} class="is-active" aria-current="page"{% endif %}>{{ item.label }}</a>
      {% endif %}
      {% endfor %}
    </nav>
  </div>
</header>
