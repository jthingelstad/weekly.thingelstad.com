{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "weekly.thingelstad.com HTTPS certificate - external DNS validation",
  "Resources": {
    "Certificate": {
      "Type": "AWS::CertificateManager::Certificate",
      "Properties": {
        "DomainName": "weekly.thingelstad.com",
        "ValidationMethod": "DNS"
      }
    }
  },
  "Outputs": {
    "CertificateArn": {
      "Value": {
        "Ref": "Certificate"
      }
    }
  }
}
