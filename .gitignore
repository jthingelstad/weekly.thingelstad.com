# Dependencies
node_modules/

# Build output
_site/

# Local cache
cache/

# Environment variables (and their backups; the example stays tracked)
.env
.env-*
.env.*
!.env.example

# OS files
.DS_Store

# Playwright MCP
.playwright-mcp/
test-results/
playwright-report/

# Local Claude settings (project-level skills under .claude/skills/ are committed)
.claude/*
!.claude/skills/

# Pagefind
_site/pagefind/

# Local audit/working files
tmp/

# Librarian corpus artifacts are built in librarian-thing and never belong
# here. The one file librarian-thing does push in, data/librarian/graph.json,
# is tracked and deliberately not ignored.
data/librarian/corpus.json
data/librarian/*.embedded.json
