# Dependencies
node_modules/

# Build output
_site/

# Local cache
cache/

# Environment variables
.env
.env-*

# OS files
.DS_Store

# Playwright MCP
.playwright-mcp/
test-results/
playwright-report/

# Local Claude settings (project-level skills under .claude/skills/ are committed)
.claude/*
!.claude/skills/

# Pagefind
_site/pagefind/

# Local audit/working files
tmp/

# Generated librarian artifacts pushed in by Studio. Listed here so a
# local rebuild (if someone wires one up) doesn't accidentally commit
# rebuilt copies — the canonical versions are committed by Studio's
# handoff via git-tree (which bypasses .gitignore).
data/librarian/corpus.json
data/librarian/graph.json
data/librarian/*.embedded.json

# Generated pipeline status report pushed in by Studio. Same caveat as above.
apps/site/_data/status.json
