<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ subject or pageTitle or title }}{% if subject or pageTitle %} — {{ site.title }}{% endif %}</title>
  <meta name="description" content="{{ description or site.description }}">

  {# Open Graph #}
  <meta property="og:title" content="{{ subject or pageTitle or title or site.title }}">
  <meta property="og:description" content="{{ description or site.description }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:type" content="{{ ogType or 'website' }}">
  <meta property="og:site_name" content="{{ site.title }}">
  {% if image %}
  <meta property="og:image" content="{{ image }}">
  <meta name="twitter:image" content="{{ image }}">
  {% endif %}
  <meta name="twitter:card" content="{{ 'summary_large_image' if image else 'summary' }}">
  <meta name="twitter:title" content="{{ subject or pageTitle or title or site.title }}">
  <meta name="twitter:description" content="{{ description or site.description }}">
  {% if publish_date %}
  <meta property="article:published_time" content="{{ publish_date | dateFormat('iso') }}">
  <meta property="article:author" content="{{ site.author }}">
  {% endif %}

  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="license" href="https://creativecommons.org/licenses/by-sa/4.0/">
  <link rel="webmention" href="https://tinylytics.app/webmention/{{ site.tinylyticsId }}">

  {# RSS feed discovery #}
  <link rel="alternate" type="application/atom+xml" title="{{ site.title }}" href="/feed.xml">
  {# Machine-readable discovery #}
  <link rel="alternate" type="text/markdown" title="LLM-friendly site index" href="/llms.txt">
  <link rel="alternate" type="application/json" title="Archive index (JSON)" href="/archive.json">
  {% if number %}
  <link rel="alternate" type="text/markdown" title="Markdown version" href="/archive/{{ number }}.txt">
  {% endif %}
  {% block head %}{% endblock %}

  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <a href="#main-content" class="skip-link">Skip to content</a>
  {% include "partials/header.njk" %}

  <main id="main-content">
    {% block content %}
      {{ content | safe }}
    {% endblock %}
  </main>

  {% include "partials/footer.njk" %}

  <script defer src="https://tinylytics.app/embed/{{ site.tinylyticsId }}.js?kudos=custom&hits&countries&events&beacon"></script>
</body>
</html>
