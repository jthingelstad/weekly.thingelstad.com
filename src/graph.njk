---
layout: layouts/base.njk
pageTitle: The Web
description: Explore the connections between sources linked across the Weekly Thing archive.
permalink: /graph/
eleventyExcludeFromCollections: true
---
<section class="graph-page">
  <div class="graph-header">
    <h1>The Web</h1>
    <p>{{ graphData.nodes.length }} sources connected across {{ graphData.issuesWithDomains }} issues. Domains that appear together cluster naturally.</p>
  </div>

  <div class="graph-controls">
    <div class="graph-search">
      <input type="text" id="graph-search" placeholder="Find a domain..." aria-label="Search domains">
    </div>
    <div class="graph-slider">
      <label for="min-appearances">Min appearances: <span id="slider-value">{{ graphData.minAppearances }}</span></label>
      <input type="range" id="min-appearances" min="3" max="15" value="{{ graphData.minAppearances }}">
    </div>
    <div class="graph-stats" id="graph-stats"></div>
  </div>

  <div class="graph-container">
    <div id="graph-canvas"></div>
    <aside id="detail-panel" class="detail-panel" hidden aria-live="polite">
      <button class="detail-close" aria-label="Close panel">&times;</button>
      <h2 class="detail-domain"></h2>
      <div class="detail-stats"></div>
      <div class="detail-section">
        <h3>Neighbors</h3>
        <ul class="detail-neighbors"></ul>
      </div>
      <div class="detail-section">
        <h3>Featured in</h3>
        <ul class="detail-issues"></ul>
      </div>
    </aside>
  </div>
</section>

<script src="https://d3js.org/d3.v7.min.js"></script>
<script>
(function() {
  // Embedded graph data from build
  var raw = {{ graphData | jsonify | safe }};

  var allNodes = raw.nodes;
  var allEdges = raw.edges;
  var domainIssues = raw.domainIssues;

  // State
  var currentMin = {{ graphData.minAppearances }};
  var selectedDomain = null;
  var simulation = null;

  // DOM refs
  var canvas = document.getElementById('graph-canvas');
  var panel = document.getElementById('detail-panel');
  var searchInput = document.getElementById('graph-search');
  var slider = document.getElementById('min-appearances');
  var sliderValue = document.getElementById('slider-value');
  var statsEl = document.getElementById('graph-stats');

  // Dimensions
  var width, height;
  function measure() {
    var rect = canvas.getBoundingClientRect();
    width = rect.width;
    height = rect.height;
  }
  measure();

  // Color scale — blue gradient by frequency
  var maxCount = d3.max(allNodes, function(d) { return d.count; });
  var colorScale = d3.scaleSequential(d3.interpolateBlues)
    .domain([1, Math.sqrt(maxCount)]);

  // Size scale
  var sizeScale = d3.scaleSqrt()
    .domain([1, maxCount])
    .range([3, 20]);

  // SVG setup
  var svg = d3.select('#graph-canvas')
    .append('svg')
    .attr('width', '100%')
    .attr('height', '100%')
    .attr('viewBox', [0, 0, width, height])
    .attr('aria-label', 'Domain co-occurrence graph');

  var g = svg.append('g');

  // Zoom
  var zoom = d3.zoom()
    .scaleExtent([0.3, 8])
    .on('zoom', function(event) {
      g.attr('transform', event.transform);
      currentZoom = event.transform.k;
      updateLabelVisibility();
    });
  svg.call(zoom);

  var currentZoom = 1;

  // Layers
  var edgeLayer = g.append('g').attr('class', 'edges');
  var nodeLayer = g.append('g').attr('class', 'nodes');
  var labelLayer = g.append('g').attr('class', 'labels');

  // Tooltip
  var tooltip = d3.select('#graph-canvas')
    .append('div')
    .attr('class', 'graph-tooltip')
    .style('opacity', 0);

  // Filter and render
  var nodes, edges, nodeById, edgeIndex;

  function filterData(minCount) {
    var nodeSet = new Set();
    nodes = allNodes.filter(function(n) {
      if (n.count >= minCount) { nodeSet.add(n.id); return true; }
      return false;
    }).map(function(n) { return Object.assign({}, n); });

    edges = allEdges.filter(function(e) {
      return nodeSet.has(e.source) && nodeSet.has(e.target);
    }).map(function(e) { return { source: e.source, target: e.target, weight: e.weight }; });

    nodeById = {};
    nodes.forEach(function(n) { nodeById[n.id] = n; });

    // Build adjacency index
    edgeIndex = {};
    edges.forEach(function(e) {
      var s = typeof e.source === 'object' ? e.source.id : e.source;
      var t = typeof e.target === 'object' ? e.target.id : e.target;
      if (!edgeIndex[s]) edgeIndex[s] = [];
      if (!edgeIndex[t]) edgeIndex[t] = [];
      edgeIndex[s].push({ neighbor: t, weight: e.weight });
      edgeIndex[t].push({ neighbor: s, weight: e.weight });
    });

    statsEl.textContent = nodes.length + ' domains, ' + edges.length + ' connections';
  }

  var maxEdgeWeight;

  function render() {
    maxEdgeWeight = d3.max(edges, function(e) { return e.weight; }) || 1;

    // Edges
    var edgeSel = edgeLayer.selectAll('line').data(edges, function(d) {
      var s = typeof d.source === 'object' ? d.source.id : d.source;
      var t = typeof d.target === 'object' ? d.target.id : d.target;
      return s + '|' + t;
    });
    edgeSel.exit().remove();
    var edgeEnter = edgeSel.enter().append('line')
      .attr('class', 'graph-edge')
      .attr('stroke-opacity', function(d) {
        return Math.max(0.03, d.weight / maxEdgeWeight * 0.3);
      });
    edgeSel = edgeEnter.merge(edgeSel);

    // Nodes
    var nodeSel = nodeLayer.selectAll('circle').data(nodes, function(d) { return d.id; });
    nodeSel.exit().remove();
    var nodeEnter = nodeSel.enter().append('circle')
      .attr('class', 'graph-node')
      .attr('r', function(d) { return sizeScale(d.count); })
      .attr('fill', function(d) { return colorScale(Math.sqrt(d.count)); })
      .call(d3.drag()
        .on('start', dragStarted)
        .on('drag', dragged)
        .on('end', dragEnded))
      .on('mouseover', onHover)
      .on('mouseout', onHoverOut)
      .on('click', onClick);
    nodeSel = nodeEnter.merge(nodeSel);

    // Labels
    var labelSel = labelLayer.selectAll('text').data(nodes, function(d) { return d.id; });
    labelSel.exit().remove();
    var labelEnter = labelSel.enter().append('text')
      .attr('class', 'graph-label')
      .attr('text-anchor', 'middle')
      .attr('dy', function(d) { return -sizeScale(d.count) - 4; })
      .text(function(d) { return d.id; });
    labelSel = labelEnter.merge(labelSel);

    updateLabelVisibility();

    // Simulation
    if (simulation) simulation.stop();

    simulation = d3.forceSimulation(nodes)
      .force('link', d3.forceLink(edges).id(function(d) { return d.id; })
        .distance(function(d) { return 80 / Math.sqrt(d.weight); })
        .strength(function(d) { return Math.min(0.5, d.weight / maxEdgeWeight); }))
      .force('charge', d3.forceManyBody().strength(-60).distanceMax(400))
      .force('center', d3.forceCenter(width / 2, height / 2))
      .force('collide', d3.forceCollide().radius(function(d) { return sizeScale(d.count) + 2; }))
      .on('tick', function() {
        edgeLayer.selectAll('line')
          .attr('x1', function(d) { return d.source.x; })
          .attr('y1', function(d) { return d.source.y; })
          .attr('x2', function(d) { return d.target.x; })
          .attr('y2', function(d) { return d.target.y; });

        nodeLayer.selectAll('circle')
          .attr('cx', function(d) { return d.x; })
          .attr('cy', function(d) { return d.y; });

        labelLayer.selectAll('text')
          .attr('x', function(d) { return d.x; })
          .attr('y', function(d) { return d.y; });
      });
  }

  function updateLabelVisibility() {
    var threshold = currentZoom >= 2 ? 3 : currentZoom >= 1.2 ? 6 : 10;
    labelLayer.selectAll('text')
      .attr('opacity', function(d) {
        if (selectedDomain === d.id) return 1;
        return d.count >= threshold ? 0.85 : 0;
      });
  }

  // Interactions
  function onHover(event, d) {
    if (selectedDomain) return;
    highlightNeighborhood(d.id, false);
    tooltip
      .html('<strong>' + d.id + '</strong><br>' + d.count + ' issues')
      .style('left', (event.offsetX + 12) + 'px')
      .style('top', (event.offsetY - 12) + 'px')
      .style('opacity', 1);
  }

  function onHoverOut() {
    if (selectedDomain) return;
    clearHighlight();
    tooltip.style('opacity', 0);
  }

  function onClick(event, d) {
    event.stopPropagation();
    tooltip.style('opacity', 0);
    selectDomain(d.id);
  }

  function highlightNeighborhood(domainId, persistent) {
    var neighbors = new Set([domainId]);
    (edgeIndex[domainId] || []).forEach(function(e) { neighbors.add(e.neighbor); });

    nodeLayer.selectAll('circle')
      .attr('opacity', function(d) { return neighbors.has(d.id) ? 1 : 0.1; });
    edgeLayer.selectAll('line')
      .attr('stroke-opacity', function(d) {
        var s = d.source.id || d.source;
        var t = d.target.id || d.target;
        if (s === domainId || t === domainId) {
          return Math.max(0.2, d.weight / maxEdgeWeight * 0.8);
        }
        return 0.02;
      });
    labelLayer.selectAll('text')
      .attr('opacity', function(d) {
        if (d.id === domainId) return 1;
        return neighbors.has(d.id) ? 0.85 : 0;
      });
  }

  function clearHighlight() {
    nodeLayer.selectAll('circle').attr('opacity', 1);
    edgeLayer.selectAll('line')
      .attr('stroke-opacity', function(d) {
        return Math.max(0.03, d.weight / maxEdgeWeight * 0.3);
      });
    updateLabelVisibility();
  }

  function selectDomain(domainId) {
    selectedDomain = domainId;
    highlightNeighborhood(domainId, true);

    // Highlight selected node
    nodeLayer.selectAll('circle')
      .classed('selected', function(d) { return d.id === domainId; });

    // Populate detail panel
    var node = nodeById[domainId];
    if (!node) return;

    panel.querySelector('.detail-domain').textContent = domainId;

    var firstSeen = node.firstSeen ? new Date(node.firstSeen).toLocaleDateString('en-US', { year: 'numeric', month: 'short', timeZone: 'UTC' }) : '?';
    var lastSeen = node.lastSeen ? new Date(node.lastSeen).toLocaleDateString('en-US', { year: 'numeric', month: 'short', timeZone: 'UTC' }) : '?';
    panel.querySelector('.detail-stats').innerHTML =
      '<span>' + node.count + ' appearances</span>' +
      '<span>' + firstSeen + ' &mdash; ' + lastSeen + '</span>';

    // Neighbors sorted by weight
    var neighbors = (edgeIndex[domainId] || [])
      .sort(function(a, b) { return b.weight - a.weight; })
      .slice(0, 15);
    var neighborList = panel.querySelector('.detail-neighbors');
    neighborList.innerHTML = neighbors.map(function(n) {
      return '<li><a href="#" data-domain="' + n.neighbor + '">' + n.neighbor + '</a> <span class="neighbor-weight">' + n.weight + ' shared</span></li>';
    }).join('');

    // Issues
    var issues = domainIssues[domainId] || [];
    var issueList = panel.querySelector('.detail-issues');
    issueList.innerHTML = issues.map(function(i) {
      var date = new Date(i.date).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' });
      return '<li><a href="/archive/' + i.number + '/">#' + i.number + '</a> <span class="issue-date">' + date + '</span></li>';
    }).join('');

    // Neighbor click navigation
    neighborList.querySelectorAll('a[data-domain]').forEach(function(a) {
      a.addEventListener('click', function(e) {
        e.preventDefault();
        selectDomain(a.dataset.domain);
        zoomToDomain(a.dataset.domain);
      });
    });

    panel.hidden = false;

    // Update URL
    var url = new URL(window.location);
    url.searchParams.set('domain', domainId);
    history.replaceState(null, '', url);
  }

  function deselectDomain() {
    selectedDomain = null;
    clearHighlight();
    nodeLayer.selectAll('circle').classed('selected', false);
    panel.hidden = true;

    var url = new URL(window.location);
    url.searchParams.delete('domain');
    history.replaceState(null, '', url);
  }

  function zoomToDomain(domainId) {
    var node = nodes.find(function(n) { return n.id === domainId; });
    if (!node || node.x == null) return;
    svg.transition().duration(500).call(
      zoom.transform,
      d3.zoomIdentity.translate(width / 2, height / 2).scale(2).translate(-node.x, -node.y)
    );
  }

  // Drag handlers
  function dragStarted(event, d) {
    if (!event.active) simulation.alphaTarget(0.3).restart();
    d.fx = d.x;
    d.fy = d.y;
  }

  function dragged(event, d) {
    d.fx = event.x;
    d.fy = event.y;
  }

  function dragEnded(event, d) {
    if (!event.active) simulation.alphaTarget(0);
    d.fx = null;
    d.fy = null;
  }

  // Close panel
  panel.querySelector('.detail-close').addEventListener('click', deselectDomain);
  svg.on('click', deselectDomain);

  // Search
  searchInput.addEventListener('input', function() {
    var q = searchInput.value.trim().toLowerCase();
    if (!q) {
      clearHighlight();
      return;
    }
    var matches = nodes.filter(function(n) { return n.id.includes(q); });
    if (matches.length === 0) {
      clearHighlight();
      return;
    }
    var matchSet = new Set(matches.map(function(n) { return n.id; }));
    nodeLayer.selectAll('circle')
      .attr('opacity', function(d) { return matchSet.has(d.id) ? 1 : 0.1; });
    labelLayer.selectAll('text')
      .attr('opacity', function(d) { return matchSet.has(d.id) ? 1 : 0; });
  });

  searchInput.addEventListener('keydown', function(e) {
    if (e.key !== 'Enter') return;
    var q = searchInput.value.trim().toLowerCase();
    var match = nodes.find(function(n) { return n.id === q; }) ||
                nodes.find(function(n) { return n.id.includes(q); });
    if (match) {
      selectDomain(match.id);
      zoomToDomain(match.id);
    }
  });

  // Slider
  slider.addEventListener('input', function() {
    currentMin = parseInt(slider.value);
    sliderValue.textContent = currentMin;
    deselectDomain();
    filterData(currentMin);
    render();
  });

  // Resize
  window.addEventListener('resize', function() {
    measure();
    svg.attr('viewBox', [0, 0, width, height]);
    if (simulation) {
      simulation.force('center', d3.forceCenter(width / 2, height / 2));
      simulation.alpha(0.3).restart();
    }
  });

  // Initial render
  filterData(currentMin);
  render();

  // URL deep link
  var params = new URLSearchParams(window.location.search);
  var domainParam = params.get('domain');
  if (domainParam && nodeById[domainParam]) {
    // Wait for simulation to settle a bit before zooming
    setTimeout(function() {
      selectDomain(domainParam);
      zoomToDomain(domainParam);
    }, 1500);
  }
})();
</script>
